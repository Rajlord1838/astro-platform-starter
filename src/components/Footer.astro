<footer class="bg-gray-900 text-white mt-12 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-3 gap-8">
        <div>
            <h3 class="text-xl font-bold mb-4">FASHION<span class="text-blue-400">STORE</span></h3>
            <p class="text-gray-400">Your ultimate destination for modern fashion and accessories.</p>
        </div>
        <div>
            <h4 class="text-lg font-semibold mb-4">Quick Links</h4>
            <ul class="space-y-2 text-gray-400">
                <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
                <li><a href="/?category=men" class="hover:text-white transition-colors">Men's Collection</a></li>
                <li><a href="/?category=women" class="hover:text-white transition-colors">Women's Collection</a></li>
                <li><a href="/?category=accessories" class="hover:text-white transition-colors">Accessories</a></li>
            </ul>
        </div>
        <div>
            <h4 class="text-lg font-semibold mb-4">Newsletter</h4>
            <p class="text-gray-400 mb-4">Subscribe to get special offers, free giveaways, and once-in-a-lifetime deals.</p>
            <div class="flex">
                <input type="email" placeholder="Enter your email" class="px-4 py-2 w-full rounded-l-md text-gray-900 focus:outline-none" />
                <button class="bg-blue-600 px-4 py-2 rounded-r-md hover:bg-blue-700 transition-colors">Subscribe</button>
            </div>
        </div>
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-12 pt-8 border-t border-gray-800 text-center text-gray-400">
        <p>&copy; {new Date().getFullYear()} Fashion Store. All rights reserved.</p>
    </div>
</footer>
