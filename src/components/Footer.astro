<footer class="bg-white border-t py-12 mt-auto">
    <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
            <div>
                <span class="font-bold text-xl uppercase tracking-tight">Fashion<span class="text-indigo-600">Store</span></span>
                <p class="mt-4 text-sm text-slate-500">Your ultimate destination for trendy and classic fashion essentials.</p>
            </div>
            <div>
                <h3 class="font-semibold mb-4">Shop</h3>
                <ul class="space-y-2 text-sm text-slate-500">
                    <li><a href="#" class="hover:text-slate-900 transition-colors">Women's Clothing</a></li>
                    <li><a href="#" class="hover:text-slate-900 transition-colors">Men's Clothing</a></li>
                    <li><a href="#" class="hover:text-slate-900 transition-colors">Accessories</a></li>
                    <li><a href="#" class="hover:text-slate-900 transition-colors">New Arrivals</a></li>
                </ul>
            </div>
            <div>
                <h3 class="font-semibold mb-4">Customer Service</h3>
                <ul class="space-y-2 text-sm text-slate-500">
                    <li><a href="#" class="hover:text-slate-900 transition-colors">Contact Us</a></li>
                    <li><a href="#" class="hover:text-slate-900 transition-colors">Shipping & Returns</a></li>
                    <li><a href="#" class="hover:text-slate-900 transition-colors">FAQ</a></li>
                    <li><a href="#" class="hover:text-slate-900 transition-colors">Track Order</a></li>
                </ul>
            </div>
            <div>
                <h3 class="font-semibold mb-4">Connect</h3>
                <ul class="space-y-2 text-sm text-slate-500">
                    <li><a href="#" class="hover:text-slate-900 transition-colors">Instagram</a></li>
                    <li><a href="#" class="hover:text-slate-900 transition-colors">Twitter</a></li>
                    <li><a href="#" class="hover:text-slate-900 transition-colors">Facebook</a></li>
                    <li><a href="#" class="hover:text-slate-900 transition-colors">Pinterest</a></li>
                </ul>
            </div>
        </div>
        <div class="border-t mt-12 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-slate-500">
            <p>&copy; {new Date().getFullYear()} FashionStore. All rights reserved.</p>
            <div class="flex gap-4">
                <a href="#" class="hover:text-slate-900 transition-colors">Privacy Policy</a>
                <a href="#" class="hover:text-slate-900 transition-colors">Terms of Service</a>
            </div>
        </div>
    </div>
</footer>
