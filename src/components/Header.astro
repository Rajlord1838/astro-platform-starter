---
import Logo from '../components/Logo.astro';
import CartIndicator from './react/CartIndicator.tsx';

const navItems = [
    { linkText: 'Home', href: '/' },
    { linkText: 'Catalog', href: '/' },
];
---

<nav class="flex flex-wrap items-center justify-between gap-4 pt-6 pb-16 sm:pt-12 sm:pb-24">
    <div class="flex items-center gap-8">
        <a href="/" class="flex items-center gap-3">
            <span class="text-2xl font-bold tracking-tight text-white">Fashion<span class="text-blue-500">Store</span></span>
        </a>
        {
            !!navItems?.length && (
                <ul class="hidden sm:flex flex-wrap gap-x-4 gap-y-1">
                    {navItems.map((item) => (
                        <li>
                            <a href={item.href} class="inline-block px-1.5 py-1 sm:px-3 sm:py-2 hover:text-blue-400 transition-colors">
                                {item.linkText}
                            </a>
                        </li>
                    ))}
                </ul>
            )
        }
    </div>

    <div class="flex items-center">
        <a href="/cart" class="relative p-2 hover:text-blue-400 transition-colors" aria-label="Shopping Cart">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
            <CartIndicator client:only="react" />
        </a>
    </div>
</nav>
