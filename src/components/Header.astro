---
import Logo from '../components/Logo.astro';
import CartBadge from './react/CartBadge';

const navItems = [
    { linkText: 'Home', href: '/' },
];
---

<header class="bg-complementary text-white shadow-md sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-6 sm:px-12">
        <nav class="flex items-center justify-between h-16 sm:h-20">
            <div class="flex items-center gap-8">
                <a href="/" class="flex-shrink-0 flex items-center">
                    <Logo />
                    <span class="ml-3 text-xl font-bold tracking-tight hidden sm:block">Fashion Store</span>
                </a>

                {!!navItems?.length && (
                    <ul class="hidden md:flex items-center gap-6">
                        {navItems.map((item) => (
                            <li>
                                <a href={item.href} class="text-sm font-medium text-gray-200 hover:text-white transition-colors">
                                    {item.linkText}
                                </a>
                            </li>
                        ))}
                    </ul>
                )}
            </div>

            <div class="flex items-center">
                <CartBadge client:load />
            </div>
        </nav>
    </div>
</header>
