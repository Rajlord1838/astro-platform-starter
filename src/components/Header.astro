---
import Logo from '../components/Logo.astro';
import { Cart } from '../components/Cart';

const navItems = [
    { linkText: 'Home', href: '/' },
    { linkText: 'Shop', href: '#' },
    { linkText: 'Categories', href: '#' },
    { linkText: 'About', href: '#' }
];
---

<nav class="flex flex-wrap items-center justify-between pt-6 pb-8 sm:pt-12 sm:pb-16 border-b border-gray-100 mb-8">
    <div class="flex items-center gap-8">
        <a href="/">
            <Logo />
        </a>
        {
            !!navItems?.length && (
                <ul class="hidden md:flex flex-wrap gap-x-6">
                    {navItems.map((item) => (
                        <li>
                            <a href={item.href} class="text-sm font-medium text-gray-700 hover:text-black transition-colors">
                                {item.linkText}
                            </a>
                        </li>
                    ))}
                </ul>
            )
        }
    </div>

    <div class="flex items-center gap-4">
        <Cart client:load />
    </div>
</nav>
