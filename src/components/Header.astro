---
import CartButton from './react/CartButton';

const navItems = [
    { linkText: 'Home', href: '/' },
    { linkText: 'Men', href: '#' },
    { linkText: 'Women', href: '#' },
    { linkText: 'Accessories', href: '#' }
];
---

<header class="flex flex-wrap items-center justify-between gap-4 pt-6 pb-12 sm:pt-10 sm:pb-16 border-b border-gray-100 mb-12">
    <a href="/" class="text-2xl font-bold tracking-tighter text-gray-900 flex items-center gap-2">
        <span class="w-8 h-8 bg-gray-900 text-white rounded flex items-center justify-center font-serif italic text-xl">F</span>
        FashionStore
    </a>

    <nav class="hidden md:block">
        {
            !!navItems?.length && (
                <ul class="flex flex-wrap gap-x-8">
                    {navItems.map((item) => (
                        <li>
                            <a href={item.href} class="inline-block text-gray-600 hover:text-gray-900 font-medium transition-colors">
                                {item.linkText}
                            </a>
                        </li>
                    ))}
                </ul>
            )
        }
    </nav>

    <div class="flex items-center gap-4">
        <CartButton client:load />
    </div>
</header>
