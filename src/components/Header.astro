---
import Cart from '../components/Cart';

const navItems = [
    { linkText: 'Home', href: '/' },
    { linkText: 'Men', href: '#' },
    { linkText: 'Women', href: '#' },
    { linkText: 'Accessories', href: '#' }
];
---

<header class="sticky top-0 z-30 w-full backdrop-blur-md bg-complementary/80 border-b border-gray-800">
    <div class="flex flex-wrap items-center justify-between gap-4 py-4 px-6 sm:px-12 max-w-7xl mx-auto">
        <a href="/" class="flex items-center gap-2 group">
            <span class="text-2xl font-black tracking-tighter text-primary">LUXE</span>
            <span class="text-xl font-bold tracking-widest text-white uppercase group-hover:text-primary transition-colors">Fashion</span>
        </a>

        {
            !!navItems?.length && (
                <nav class="hidden md:block">
                    <ul class="flex flex-wrap gap-x-8">
                        {navItems.map((item) => (
                            <li>
                                <a href={item.href} class="inline-block py-2 text-sm font-semibold uppercase tracking-wider text-gray-300 hover:text-primary transition-colors">
                                    {item.linkText}
                                </a>
                            </li>
                        ))}
                    </ul>
                </nav>
            )
        }

        <div class="flex items-center gap-4 ml-auto md:ml-0">
            <Cart client:load />
        </div>
    </div>
</header>
