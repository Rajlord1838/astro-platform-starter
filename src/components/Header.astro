---
import { CartIcon } from './CartIcon';

const navItems = [
    { linkText: 'Home', href: '/' },
    { linkText: 'Shop', href: '/#shop' },
    { linkText: 'About', href: '#' },
];
---

<header class="flex flex-wrap items-center justify-between gap-4 pt-6 pb-16 sm:pt-12 sm:pb-24">
    <div class="flex items-center gap-6">
        <a href="/" class="flex items-center gap-2">
            <span class="text-2xl font-bold tracking-tighter text-primary">FASHION<span class="text-white">STORE</span></span>
        </a>
        {
            !!navItems?.length && (
                <ul class="hidden sm:flex flex-wrap gap-x-6 gap-y-1 ml-8">
                    {navItems.map((item) => (
                        <li>
                            <a href={item.href} class="inline-block py-2 font-medium hover:text-primary transition-colors">
                                {item.linkText}
                            </a>
                        </li>
                    ))}
                </ul>
            )
        }
    </div>

    <div class="flex items-center gap-4">
        <CartIcon client:load />
    </div>
</header>
