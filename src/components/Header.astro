---
import Logo from '../components/Logo.astro';
import { CartFlyout } from './react/CartFlyout';

const navItems = [
    { linkText: 'Shop', href: '/' }
];
---

<nav class="flex flex-wrap items-center justify-between gap-4 pt-6 pb-16 sm:pt-12 sm:pb-24">
    <div class="flex items-center gap-8">
        <a href="/" class="flex items-center gap-2">
            <Logo />
            <span class="text-xl font-bold tracking-tight text-white hidden sm:inline-block">Fashion Store</span>
        </a>
        {
            !!navItems?.length && (
                <ul class="flex flex-wrap gap-x-4 gap-y-1">
                    {navItems.map((item) => (
                        <li>
                            <a href={item.href} class="inline-block px-1.5 py-1 sm:px-3 sm:py-2 text-gray-300 hover:text-white transition-colors">
                                {item.linkText}
                            </a>
                        </li>
                    ))}
                </ul>
            )
        }
    </div>
    <div class="ml-auto">
        <CartFlyout client:load />
    </div>
</nav>
