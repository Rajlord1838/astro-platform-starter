---
import Logo from '../components/Logo.astro';
import { CartButton } from './react/CartButton';
import { Cart } from './react/Cart';

const navItems = [
    { linkText: 'Home', href: '/' },
    { linkText: 'Men', href: '#' },
    { linkText: 'Women', href: '#' },
    { linkText: 'Shoes', href: '#' }
];
---

<header class="flex flex-wrap items-center justify-between gap-4 pt-6 pb-12 sm:pt-12 sm:pb-16 border-b border-gray-800 mb-8">
    <nav class="flex items-center gap-8">
        <a href="/">
            <Logo />
        </a>
        {
            !!navItems?.length && (
                <ul class="flex flex-wrap gap-x-6 gap-y-1">
                    {navItems.map((item) => (
                        <li>
                            <a href={item.href} class="text-gray-300 hover:text-white transition-colors">
                                {item.linkText}
                            </a>
                        </li>
                    ))}
                </ul>
            )
        }
    </nav>
    <div class="flex items-center">
        <CartButton client:load />
    </div>
    <Cart client:load />
</header>
