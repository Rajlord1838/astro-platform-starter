---
import Cart from './Cart.tsx';

const navItems = [
    { linkText: 'Home', href: '/' },
    { linkText: 'Shop', href: '/' },
];
---

<header class="flex flex-wrap items-center justify-between gap-4 pt-6 pb-16 sm:pt-12 sm:pb-24">
    <div class="flex items-center gap-6">
        <a href="/" class="text-2xl font-bold no-underline text-gray-900">
            Fashion Store
        </a>
        {
            !!navItems?.length && (
                <ul class="flex flex-wrap gap-x-4 gap-y-1">
                    {navItems.map((item) => (
                        <li>
                            <a href={item.href} class="inline-block px-1.5 py-1 sm:px-3 sm:py-2 text-gray-600 hover:text-gray-900">
                                {item.linkText}
                            </a>
                        </li>
                    ))}
                </ul>
            )
        }
    </div>
    <div>
        <Cart client:load />
    </div>
</header>
