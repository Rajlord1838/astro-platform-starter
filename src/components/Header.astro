---
import { CartIcon } from './CartIcon';

const navItems = [
    { linkText: 'Shop All', href: '/' },
    { linkText: 'New Arrivals', href: '#' },
    { linkText: 'Collections', href: '#' },
    { linkText: 'About Us', href: '#' }
];
---

<nav class="flex flex-wrap items-center gap-4 pt-6 pb-16 sm:pt-12 sm:pb-24">
    <a href="/" class="flex-grow sm:flex-grow-0">
        <span class="text-3xl font-bold tracking-tight text-white border-b-2 border-primary">Fashion Store</span>
    </a>

    <div class="flex flex-grow justify-between items-center w-full sm:w-auto">
        {
            !!navItems?.length && (
                <ul class="flex flex-wrap gap-x-4 gap-y-1">
                    {navItems.map((item) => (
                        <li>
                            <a href={item.href} class="inline-block px-1.5 py-1 sm:px-3 sm:py-2 hover:text-primary transition-colors">
                                {item.linkText}
                            </a>
                        </li>
                    ))}
                </ul>
            )
        }

        <div class="ml-auto">
            <CartIcon client:load />
        </div>
    </div>
</nav>
