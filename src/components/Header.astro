---
import Logo from '../components/Logo.astro';
import { HeaderCartButton } from './HeaderCartButton';
---

<header class="flex items-center justify-between py-6">
    <div class="flex items-center gap-4">
        <a href="/" class="flex items-center gap-2 no-underline text-white hover:text-white/80 transition-colors">
            <Logo />
            <span class="text-xl font-bold tracking-tight">FashionStore</span>
        </a>
    </div>

    <nav class="hidden md:flex items-center gap-8">
        <a href="#" class="text-sm font-medium hover:text-primary transition-colors">Women</a>
        <a href="#" class="text-sm font-medium hover:text-primary transition-colors">Men</a>
        <a href="#" class="text-sm font-medium hover:text-primary transition-colors">Accessories</a>
        <a href="#" class="text-sm font-medium hover:text-primary transition-colors">Sale</a>
    </nav>

    <div class="flex items-center gap-4">
        <HeaderCartButton client:load />
    </div>
</header>
