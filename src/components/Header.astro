---
import Logo from '../components/Logo.astro';
import Cart from './react/Cart';
---

<header class="flex items-center justify-between pt-6 pb-12 sm:pt-8 sm:pb-16 border-b border-gray-800 mb-8">
    <a href="/" class="hover:opacity-80 transition-opacity" aria-label="Home">
        <Logo />
    </a>

    <nav class="flex items-center gap-6">
        <a href="/" class="text-white hover:text-primary font-medium transition-colors">Shop</a>
        <Cart client:load />
    </nav>
</header>
