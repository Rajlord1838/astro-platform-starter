---
import Logo from '../components/Logo.astro';
import CartIcon from './CartIcon.tsx';
---

<nav class="flex flex-wrap items-center justify-between gap-4 pt-6 pb-16 sm:pt-12 sm:pb-24">
    <a href="/" class="flex items-center gap-2 hover:opacity-80 transition-opacity">
        <Logo />
        <span class="text-xl font-bold tracking-tight text-white hidden sm:block">Fashion Store</span>
    </a>

    <div class="flex items-center gap-4">
        <ul class="flex items-center gap-4 text-sm font-medium text-neutral-300">
            <li><a href="/" class="hover:text-white transition-colors">Men</a></li>
            <li><a href="/" class="hover:text-white transition-colors">Women</a></li>
            <li><a href="/" class="hover:text-white transition-colors">Accessories</a></li>
        </ul>
        <div class="w-px h-6 bg-neutral-700 mx-2 hidden sm:block"></div>
        <CartIcon client:load />
    </div>
</nav>
