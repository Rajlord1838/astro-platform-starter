        <a href="/" class="text-2xl font-bold tracking-widest text-gray-900 uppercase">
            Chic Boutique
        </a>

        <nav class="hidden md:flex gap-8">
            <a href="#" class="text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors">Women</a>
            <a href="#" class="text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors">Men</a>
            <a href="#" class="text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors">Accessories</a>
            <a href="#" class="text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors">Sale</a>
        </nav>

        <div class="flex items-center gap-4">
