---
const navItems = [
    { linkText: 'Home', href: '/' },
    { linkText: 'Shop', href: '/shop' }
];
---

<header class="flex flex-wrap items-center justify-between gap-4 py-6 sm:py-8 border-b border-gray-100">
    <a href="/" class="text-2xl font-bold tracking-widest uppercase">
        VOGUE
    </a>
    {
        !!navItems?.length && (
            <nav>
                <ul class="flex flex-wrap gap-x-8 gap-y-2">
                    {navItems.map((item) => (
                        <li>
                            <a href={item.href} class="inline-block text-sm font-medium uppercase tracking-wide hover:text-gray-500">
                                {item.linkText}
                            </a>
                        </li>
                    ))}
                </ul>
            </nav>
        )
    }
</header>
