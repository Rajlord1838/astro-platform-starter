---
import CartIcon from './CartIcon';

const navItems = [
    { linkText: 'Home', href: '/' },
    { linkText: 'Men', href: '/category/men' },
    { linkText: 'Women', href: '/category/women' },
    { linkText: 'Accessories', href: '/category/accessories' },
];
---

<nav class="flex flex-wrap items-center justify-between gap-4 pt-6 pb-16 sm:pt-12 sm:pb-24 border-b border-gray-800">
    <div class="flex items-center gap-8">
        <a href="/" class="text-2xl font-bold text-white tracking-widest">
            FASHION STORE
        </a>
        {
            !!navItems?.length && (
                <ul class="flex flex-wrap gap-x-6 gap-y-1">
                    {navItems.map((item) => (
                        <li>
                            <a href={item.href} class="inline-block px-1.5 py-1 hover:text-gray-300 transition-colors">
                                {item.linkText}
                            </a>
                        </li>
                    ))}
                </ul>
            )
        }
    </div>

    <div class="flex items-center">
        <a href="/cart" class="p-2 hover:text-gray-300 transition-colors" aria-label="Shopping Cart">
            <CartIcon client:load />
        </a>
    </div>
</nav>
