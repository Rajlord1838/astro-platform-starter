---
import CartButton from './react/CartButton';
---

<header class="sticky top-0 z-40 w-full bg-primary shadow-md">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
        <div class="flex items-center gap-2">
            <a href="/" class="text-2xl font-bold tracking-tighter text-primary-content no-underline hover:opacity-100">
                LUMIÈRE
            </a>
        </div>
        <nav class="hidden md:flex gap-6">
            <a href="/" class="text-sm font-medium text-primary-content/80 hover:text-primary-content no-underline">New Arrivals</a>
            <a href="/" class="text-sm font-medium text-primary-content/80 hover:text-primary-content no-underline">Women</a>
            <a href="/" class="text-sm font-medium text-primary-content/80 hover:text-primary-content no-underline">Men</a>
            <a href="/" class="text-sm font-medium text-primary-content/80 hover:text-primary-content no-underline">Sale</a>
        </nav>
        <div class="flex items-center gap-4">
            <CartButton client:load />
        </div>
    </div>
</header>
