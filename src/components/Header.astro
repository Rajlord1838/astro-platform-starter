---
import Logo from '../components/Logo.astro';
import { CartButton } from '../components/react/CartButton';

const navItems = [
    { linkText: 'Home', href: '/' },
    { linkText: 'Shop', href: '/' },
    { linkText: 'About', href: '#' },
    { linkText: 'Contact', href: '#' }
];
---

<nav class="flex items-center justify-between pt-6 pb-16 sm:pt-12 sm:pb-24">
    <div class="flex items-center gap-4">
        <a href="/">
            <Logo />
        </a>
        {
            !!navItems?.length && (
                <ul class="hidden sm:flex flex-wrap gap-x-4 gap-y-1 ml-4">
                    {navItems.map((item) => (
                        <li>
                            <a href={item.href} class="inline-block px-1.5 py-1 sm:px-3 sm:py-2">
                                {item.linkText}
                            </a>
                        </li>
                    ))}
                </ul>
            )
        }
    </div>
    <div>
        <CartButton client:load />
    </div>
</nav>
