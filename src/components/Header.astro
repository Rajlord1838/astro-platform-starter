---
import Logo from './Logo.astro';
import { CartButton } from './CartButton';
---

<header class="flex items-center justify-between py-6">
    <div class="flex items-center gap-4">
        <a href="/" class="hover:opacity-80 transition-opacity">
            <Logo />
        </a>
        <span class="text-xl font-bold tracking-tight">Fashion Hub</span>
    </div>

    <nav class="flex items-center gap-6">
        <a href="/" class="text-sm font-medium hover:text-primary transition-colors no-underline">Shop</a>
        <a href="#" class="text-sm font-medium hover:text-primary transition-colors no-underline">About</a>
        <CartButton client:load />
    </nav>
</header>
