---
import Logo from '../components/Logo.astro';
import { CartButton } from '../components/react/CartButton';
---
<header class="bg-white sticky top-0 z-10 shadow-sm border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
            <div class="flex-shrink-0">
                <a href="/" class="flex items-center gap-2">
                    <Logo />
                    <span class="font-bold text-xl tracking-tight hidden sm:block">FashionStore</span>
                </a>
            </div>
            <nav class="hidden md:flex space-x-8">
                <a href="#" class="text-gray-500 hover:text-gray-900 font-medium transition-colors">Women</a>
                <a href="#" class="text-gray-500 hover:text-gray-900 font-medium transition-colors">Men</a>
                <a href="#" class="text-gray-500 hover:text-gray-900 font-medium transition-colors">Accessories</a>
                <a href="#" class="text-gray-500 hover:text-gray-900 font-medium transition-colors">Sale</a>
            </nav>
            <div class="flex items-center gap-4">
                <CartButton client:load />
            </div>
        </div>
    </div>
</header>
