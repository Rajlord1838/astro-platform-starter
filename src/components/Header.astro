---
import Logo from '../components/Logo.astro';
import CartButton from './react/CartButton';
import CartModal from './react/CartModal';
---

<header className="flex items-center justify-between pt-6 pb-12 sm:pt-12 sm:pb-16">
    <a href="/" className="hover:opacity-80 transition-opacity">
        <Logo />
    </a>

    <div className="flex items-center gap-4">
        <nav className="hidden sm:block">
            <ul className="flex gap-6 text-sm font-medium text-gray-300">
                <li><a href="#" className="hover:text-white transition-colors no-underline">Men</a></li>
                <li><a href="#" className="hover:text-white transition-colors no-underline">Women</a></li>
                <li><a href="#" className="hover:text-white transition-colors no-underline">Accessories</a></li>
            </ul>
        </nav>

        <CartButton client:load />
    </div>

    <CartModal client:load />
</header>
