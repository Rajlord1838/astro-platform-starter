---
import Logo from '../components/Logo.astro';
import CartButton from './CartButton.tsx';

const navItems = [
    { linkText: 'Home', href: '/' },
    { linkText: 'Men', href: '#' },
    { linkText: 'Women', href: '#' },
    { linkText: 'Accessories', href: '#' }
];
---

<header class="flex flex-wrap items-center justify-between pt-6 pb-16 sm:pt-12 sm:pb-24 text-gray-900">
    <div class="flex items-center gap-8">
        <a href="/" class="text-2xl font-bold tracking-wider text-black no-underline hover:text-gray-700">
            FASHION STORE
        </a>
        {
            !!navItems?.length && (
                <nav>
                    <ul class="flex flex-wrap gap-x-4 gap-y-1 m-0 p-0 list-none">
                        {navItems.map((item) => (
                            <li>
                                <a href={item.href} class="inline-block px-1.5 py-1 sm:px-3 sm:py-2 text-gray-700 hover:text-black font-medium no-underline">
                                    {item.linkText}
                                </a>
                            </li>
                        ))}
                    </ul>
                </nav>
            )
        }
    </div>
    <div class="flex items-center">
        <CartButton client:load />
    </div>
</header>
