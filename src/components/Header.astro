---
import Cart from './Cart';
---

<header class="bg-white shadow-sm sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
            <div class="flex items-center">
                <a href="/" class="text-2xl font-bold text-gray-900 tracking-tight">
                    FASHION<span class="text-blue-600">STORE</span>
                </a>
            </div>

            <nav class="hidden md:flex space-x-8">
                <a href="/" class="text-gray-600 hover:text-gray-900 font-medium">Home</a>
                <a href="/?category=men" class="text-gray-600 hover:text-gray-900 font-medium">Men</a>
                <a href="/?category=women" class="text-gray-600 hover:text-gray-900 font-medium">Women</a>
                <a href="/?category=accessories" class="text-gray-600 hover:text-gray-900 font-medium">Accessories</a>
            </nav>

            <div class="flex items-center">
                <Cart client:load />
            </div>
        </div>
    </div>
</header>
