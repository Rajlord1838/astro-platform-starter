---
import Logo from '../components/Logo.astro';
import CartButton from './react/CartButton';

const navItems = [
    { linkText: 'Men', href: '#men' },
    { linkText: 'Women', href: '#women' },
    { linkText: 'Kids', href: '#kids' }
];
---

<header class="flex flex-wrap items-center justify-between gap-4 pt-6 pb-16 sm:pt-12 sm:pb-24">
    <div class="flex items-center gap-6">
        <a href="/">
            <Logo />
        </a>
        {
            !!navItems?.length && (
                <ul class="flex flex-wrap gap-x-4 gap-y-1">
                    {navItems.map((item) => (
                        <li>
                            <a href={item.href} class="inline-block px-1.5 py-1 sm:px-3 sm:py-2 hover:text-primary transition-colors font-medium">
                                {item.linkText}
                            </a>
                        </li>
                    ))}
                </ul>
            )
        }
    </div>
    <div>
        <CartButton client:load />
    </div>
</header>
