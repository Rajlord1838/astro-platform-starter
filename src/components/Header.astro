---
import CartButton from './react/CartButton';
---

<header class="bg-white border-b sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
            <div class="flex-shrink-0 flex items-center">
                <a href="/" class="text-2xl font-bold tracking-tight text-gray-900">
                    FASHION<span class="text-gray-500">STORE</span>
                </a>
            </div>

            <nav class="hidden md:flex space-x-8">
                <a href="#" class="text-gray-700 hover:text-black px-3 py-2 text-sm font-medium">New Arrivals</a>
                <a href="#" class="text-gray-700 hover:text-black px-3 py-2 text-sm font-medium">Men</a>
                <a href="#" class="text-gray-700 hover:text-black px-3 py-2 text-sm font-medium">Women</a>
                <a href="#" class="text-gray-700 hover:text-black px-3 py-2 text-sm font-medium">Accessories</a>
            </nav>

            <div class="flex items-center">
                <CartButton client:load />
            </div>
        </div>
    </div>
</header>
