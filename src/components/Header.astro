---
import Cart from './Cart';

const navItems = [
    { linkText: 'Home', href: '/' },
    { linkText: 'Men', href: '#' },
    { linkText: 'Women', href: '#' },
    { linkText: 'Accessories', href: '#' },
];
---

<header class="flex flex-wrap items-center justify-between gap-4 pt-6 pb-16 sm:pt-12 sm:pb-24 border-b border-gray-800 mb-8">
    <div class="flex items-center gap-8">
        <a href="/" class="text-2xl font-bold tracking-tighter">
            FASHION<span class="text-blue-500">STORE</span>
        </a>
        {
            !!navItems?.length && (
                <ul class="hidden sm:flex flex-wrap gap-x-6 gap-y-1">
                    {navItems.map((item) => (
                        <li>
                            <a href={item.href} class="inline-block py-1 hover:text-blue-400 transition-colors">
                                {item.linkText}
                            </a>
                        </li>
                    ))}
                </ul>
            )
        }
    </div>

    <div class="flex items-center gap-4">
        <Cart client:load />
    </div>
</header>
