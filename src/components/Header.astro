---
import Logo from '../components/Logo.astro';
import CartIcon from '../components/CartIcon.tsx';

const navItems = [
    { linkText: 'Home', href: '/' },
    { linkText: 'Cart', href: '/cart' },
];
---

<header class="flex flex-wrap items-center justify-between gap-4 pt-6 pb-8 border-b border-gray-200">
    <a href="/" class="flex items-center gap-2">
        <span class="text-2xl font-bold tracking-tight">FashionStore</span>
    </a>

    <nav>
        {
            !!navItems?.length && (
                <ul class="flex flex-wrap items-center gap-x-4 gap-y-1">
                    {navItems.map((item) => (
                        <li>
                            {item.linkText === 'Cart' ? (
                                <a href={item.href} class="inline-flex items-center px-1.5 py-1 sm:px-3 sm:py-2 hover:text-primary transition-colors">
                                    <CartIcon client:load />
                                </a>
                            ) : (
                                <a href={item.href} class="inline-block px-1.5 py-1 sm:px-3 sm:py-2 font-medium hover:text-primary transition-colors">
                                    {item.linkText}
                                </a>
                            )}
                        </li>
                    ))}
                </ul>
            )
        }
    </nav>
</header>
