---
import Logo from '../components/Logo.astro';
import { HeaderCart } from './react/HeaderCart';

const navItems = [
    { linkText: 'Home', href: '/' },
    { linkText: 'Shop', href: '#' },
    { linkText: 'About', href: '#' },
    { linkText: 'Contact', href: '#' }
];
---

<nav class="flex flex-wrap items-center justify-between gap-4 pt-6 pb-16 sm:pt-12 sm:pb-24">
    <div class="flex flex-wrap items-center gap-4 sm:gap-8">
        <a href="/">
            <Logo />
        </a>
        {
            !!navItems?.length && (
                <ul class="flex flex-wrap gap-x-2 gap-y-1 sm:gap-x-4">
                    {navItems.map((item) => (
                        <li>
                            <a href={item.href} class="inline-block px-2 py-1 text-slate-300 hover:text-white transition-colors sm:px-3 sm:py-2">
                                {item.linkText}
                            </a>
                        </li>
                    ))}
                </ul>
            )
        }
    </div>

    <div>
        <HeaderCart client:load />
    </div>
</nav>
