---
import CartIcon from './CartIcon';
import CartModal from './CartModal';

const navItems = [
    { linkText: 'Home', href: '/' },
    { linkText: 'Shop', href: '#' },
    { linkText: 'Collections', href: '#' },
    { linkText: 'About', href: '#' }
];
---

<header class="flex flex-wrap items-center justify-between gap-4 py-6 sm:py-8 border-b border-gray-100">
    <a href="/" class="text-2xl font-bold tracking-tight text-gray-900">
        Fashion<span class="text-blue-600">Store</span>
    </a>

    <nav>
        {
            !!navItems?.length && (
                <ul class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm font-medium text-gray-600">
                    {navItems.map((item) => (
                        <li>
                            <a href={item.href} class="hover:text-gray-900 transition-colors">
                                {item.linkText}
                            </a>
                        </li>
                    ))}
                </ul>
            )
        }
    </nav>

    <div class="flex items-center gap-4">
        <CartIcon client:load />
    </div>

    <CartModal client:load />
</header>
