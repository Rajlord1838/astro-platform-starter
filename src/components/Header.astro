        <a href="/" class="text-sm font-medium hover:text-gray-300 transition-colors">Shop</a>
        <a href="#" class="text-sm font-medium hover:text-gray-300 transition-colors">Categories</a>
        <a href="#" class="text-sm font-medium hover:text-gray-300 transition-colors">About</a>
