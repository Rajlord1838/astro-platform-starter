---
import CartIcon from './CartIcon';

const navItems = [
    { linkText: 'Home', href: '/' },
    { linkText: 'Men', href: '#' },
    { linkText: 'Women', href: '#' },
    { linkText: 'Accessories', href: '#' }
];
---

<header class="py-6 sm:py-8 border-b border-white/10 mb-8 sm:mb-12">
    <div class="flex flex-wrap items-center justify-between gap-4">
        <a href="/" class="text-2xl font-bold tracking-tight text-white flex items-center">
            <span class="text-blue-500 mr-2">Style</span>Store
        </a>

        <nav class="flex-grow flex justify-center order-last sm:order-none w-full sm:w-auto mt-4 sm:mt-0">
            {!!navItems?.length && (
                <ul class="flex flex-wrap gap-x-6 gap-y-2">
                    {navItems.map((item) => (
                        <li>
                            <a href={item.href} class="text-gray-300 hover:text-white transition-colors font-medium">
                                {item.linkText}
                            </a>
                        </li>
                    ))}
                </ul>
            )}
        </nav>

        <div class="flex items-center">
            <CartIcon client:load />
        </div>
    </div>
</header>
