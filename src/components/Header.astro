---
import CartIcon from '../components/CartIcon';

const navItems = [
    { linkText: 'Women', href: '#' },
    { linkText: 'Men', href: '#' },
    { linkText: 'Accessories', href: '#' },
    { linkText: 'Sale', href: '#' }
];
---

<header class="bg-white shadow-sm sticky top-0 z-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="flex items-center justify-between h-16">
            <div class="flex-shrink-0 flex items-center">
                <a href="/" class="font-bold text-xl tracking-tight text-gray-900 hover:text-primary transition-colors">
                    FASHION STORE
                </a>
            </div>

            <div class="hidden sm:block">
                {!!navItems?.length && (
                    <ul class="flex space-x-8">
                        {navItems.map((item) => (
                            <li>
                                <a href={item.href} class="text-gray-700 hover:text-primary transition-colors px-3 py-2 text-sm font-medium">
                                    {item.linkText}
                                </a>
                            </li>
                        ))}
                    </ul>
                )}
            </div>

            <div class="flex items-center">
                <CartIcon client:load />
            </div>
        </nav>
    </div>
</header>
