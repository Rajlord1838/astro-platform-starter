---
import Logo from '../components/Logo.astro';
import CartButton from '../components/react/CartButton';
import Cart from '../components/react/Cart';

const navItems = [
    { linkText: 'Shop All', href: '/' },
    { linkText: 'New Arrivals', href: '/new' },
    { linkText: 'Collections', href: '/collections' },
    { linkText: 'About', href: '/about' }
];
---

<header class="sticky top-0 z-40 w-full bg-white/80 backdrop-blur-md border-b border-gray-200">
    <div class="flex items-center justify-between w-full max-w-7xl mx-auto px-6 py-4">
        <a href="/" class="flex items-center gap-2 text-black font-bold text-xl uppercase tracking-widest">
            FASHION<span class="font-light">STORE</span>
        </a>

        <nav class="hidden md:flex items-center gap-8">
            {navItems.map((item) => (
                <a href={item.href} class="text-sm font-medium text-gray-700 hover:text-black uppercase tracking-wider transition-colors">
                    {item.linkText}
                </a>
            ))}
        </nav>

        <div class="flex items-center gap-4">
            <CartButton client:load />
        </div>
    </div>
</header>
<Cart client:load />
