    <nav class="hidden md:flex space-x-8">
      <a href="#" class="text-gray-500 hover:text-gray-900 px-3 py-2 text-sm font-medium">Women</a>
      <a href="#" class="text-gray-500 hover:text-gray-900 px-3 py-2 text-sm font-medium">Men</a>
      <a href="#" class="text-gray-500 hover:text-gray-900 px-3 py-2 text-sm font-medium">Accessories</a>
    </nav>

    <div class="flex items-center">
