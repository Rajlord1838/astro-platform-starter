---
import { HeaderCartButton } from './react/HeaderCartButton';
---

<header class="bg-white border-b sticky top-0 z-40">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
            <div class="flex items-center gap-4">
                <a href="/" class="text-2xl font-bold tracking-tighter text-black">
                    FASHION
                </a>
                <nav class="hidden md:flex ml-8 gap-6 text-sm font-medium text-gray-600">
                    <a href="#" class="hover:text-black">New Arrivals</a>
                    <a href="#" class="hover:text-black">Clothing</a>
                    <a href="#" class="hover:text-black">Shoes</a>
                    <a href="#" class="hover:text-black">Accessories</a>
                </nav>
            </div>
            <div class="flex items-center gap-4">
                <HeaderCartButton client:load />
            </div>
        </div>
    </div>
</header>
