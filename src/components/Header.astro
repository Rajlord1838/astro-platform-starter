---
import CartBadge from './react/CartBadge';
---

<header class="sticky top-0 z-40 bg-white border-b border-gray-200 shadow-sm">
    <div class="max-w-7xl mx-auto px-6 sm:px-12 flex items-center justify-between h-16">
        <a href="/" class="flex items-center gap-2 text-xl font-bold tracking-tighter text-gray-900">
            FASHION<span class="text-gray-500">STORE</span>
        </a>

        <nav class="hidden md:flex gap-8 text-sm font-medium text-gray-600">
            <a href="#" class="hover:text-black">New Arrivals</a>
            <a href="#" class="hover:text-black">Men</a>
            <a href="#" class="hover:text-black">Women</a>
            <a href="#" class="hover:text-black">Accessories</a>
        </nav>

        <div class="flex items-center gap-4">
            <CartBadge client:load />
        </div>
    </div>
</header>
