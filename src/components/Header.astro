---
import { CartButton } from './react/CartButton';

const navItems = [
    { linkText: 'Home', href: '/' }
];
---

<nav class="flex flex-wrap items-center justify-between gap-4 pt-6 pb-16 sm:pt-12 sm:pb-24">
    <a href="/" class="flex items-center gap-2 text-2xl font-bold tracking-tight text-gray-900 no-underline hover:opacity-80 transition-opacity">
        Fashion Store
    </a>

    <div class="flex items-center gap-6">
        {
            !!navItems?.length && (
                <ul class="flex flex-wrap gap-x-4 gap-y-1">
                    {navItems.map((item) => (
                        <li>
                            <a href={item.href} class="inline-block px-1.5 py-1 sm:px-3 sm:py-2 text-gray-700 hover:text-primary no-underline font-medium">
                                {item.linkText}
                            </a>
                        </li>
                    ))}
                </ul>
            )
        }

        <div class="bg-primary rounded-full">
            <CartButton client:load />
        </div>
    </div>
</nav>
