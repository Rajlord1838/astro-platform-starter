---
import Cart from './Cart';
---

<header class="flex flex-wrap items-center justify-between gap-4 py-6 sm:py-8 border-b border-gray-800 mb-10">
    <a href="/" class="text-2xl font-bold tracking-tight text-white hover:text-primary transition-colors no-underline">
        VOGUE<span class="text-primary">STORE</span>
    </a>

    <nav class="hidden md:block">
        <ul class="flex gap-8 font-medium">
            <li><a href="#" class="hover:text-primary transition-colors text-gray-300 no-underline">New Arrivals</a></li>
            <li><a href="#" class="hover:text-primary transition-colors text-gray-300 no-underline">Clothing</a></li>
            <li><a href="#" class="hover:text-primary transition-colors text-gray-300 no-underline">Accessories</a></li>
            <li><a href="#" class="hover:text-primary transition-colors text-gray-300 no-underline">Sale</a></li>
        </ul>
    </nav>

    <div class="flex items-center gap-4">
        <Cart client:load />
    </div>
</header>
