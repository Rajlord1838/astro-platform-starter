---
const navItems = [
    { linkText: 'Home', href: '/' },
    { linkText: 'Products', href: '/products' },
    { linkText: 'Cart', href: '/cart' }
];
---

<nav class="flex flex-wrap items-center justify-between gap-4 pt-6 pb-8 border-b border-gray-200">
    <a href="/" class="text-2xl font-bold tracking-widest uppercase">
        Aura Fashion
    </a>
    {
        !!navItems?.length && (
            <ul class="flex flex-wrap gap-x-4 gap-y-1">
                {navItems.map((item) => (
                    <li>
                        <a href={item.href} class="inline-block px-1.5 py-1 sm:px-3 sm:py-2">
                            {item.linkText}
                        </a>
                    </li>
                ))}
            </ul>
        )
    }
</nav>
