---
import Logo from './Logo.astro';
import { HeaderCart } from './react/HeaderCart.tsx';
---

<header class="bg-white border-b border-gray-100 sticky top-0 z-30">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
            <div class="flex items-center gap-2">
                <a href="/" class="flex items-center gap-2 hover:opacity-80 transition-opacity">
                    <Logo />
                    <span class="font-bold text-xl tracking-tight text-gray-900">Fashion<span class="text-primary">Store</span></span>
                </a>
            </div>

            <nav class="hidden md:flex items-center gap-6">
                <a href="/" class="text-gray-600 hover:text-primary font-medium">Home</a>
                <a href="#" class="text-gray-600 hover:text-primary font-medium">New Arrivals</a>
                <a href="#" class="text-gray-600 hover:text-primary font-medium">Men</a>
                <a href="#" class="text-gray-600 hover:text-primary font-medium">Women</a>
            </nav>

            <div class="flex items-center gap-4">
                <HeaderCart client:load />
            </div>
        </div>
    </div>
</header>
