---
import Logo from '../components/Logo.astro';
import CartIcon from './CartIcon.tsx';

const navItems = [
    { linkText: 'Home', href: '/' },
    { linkText: 'Shop All', href: '#' },
    { linkText: 'Men', href: '#' },
    { linkText: 'Women', href: '#' }
];
---

<nav class="flex flex-wrap items-center justify-between gap-4 pt-6 pb-16 sm:pt-12 sm:pb-24">
    <div class="flex items-center gap-4">
        <a href="/">
            <Logo />
        </a>
        {
            !!navItems?.length && (
                <ul class="flex flex-wrap gap-x-4 gap-y-1 ml-4">
                    {navItems.map((item) => (
                        <li>
                            <a href={item.href} class="inline-block px-1.5 py-1 sm:px-3 sm:py-2 hover:text-gray-300">
                                {item.linkText}
                            </a>
                        </li>
                    ))}
                </ul>
            )
        }
    </div>
    <div class="flex items-center">
        <CartIcon client:load />
    </div>
</nav>
