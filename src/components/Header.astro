---
import HeaderCartButton from './react/HeaderCartButton';
---

<header class="sticky top-0 z-40 w-full border-b bg-white">
    <div class="container mx-auto px-4 h-16 flex items-center justify-between">
        <div class="flex gap-6 items-center">
            <a href="/" class="flex items-center space-x-2">
                <span class="font-bold text-xl uppercase tracking-tight">Fashion<span class="text-indigo-600">Store</span></span>
            </a>
            <nav class="hidden md:flex gap-6">
                <a href="#" class="text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors">Women</a>
                <a href="#" class="text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors">Men</a>
                <a href="#" class="text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors">Accessories</a>
            </nav>
        </div>
        <div class="flex items-center gap-4">
            <HeaderCartButton client:load />
        </div>
    </div>
</header>
