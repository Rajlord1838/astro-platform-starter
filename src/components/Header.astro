---
import { CartIcon } from './react/CartIcon';

const navItems = [
    { linkText: 'Shop', href: '/' },
    { linkText: 'Categories', href: '#' },
    { linkText: 'About', href: '#' }
];
---

<header class="bg-white border-b border-neutral-200 sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
            <div class="flex-shrink-0 flex items-center">
                <a href="/" class="text-2xl font-bold tracking-tighter">
                    FASHION.
                </a>
            </div>

            <nav class="hidden md:flex space-x-8">
                {navItems.map((item) => (
                    <a
                        href={item.href}
                        class="text-neutral-600 hover:text-neutral-900 px-3 py-2 text-sm font-medium transition-colors"
                    >
                        {item.linkText}
                    </a>
                ))}
            </nav>

            <div class="flex items-center">
                <CartIcon client:load />
            </div>
        </div>
    </div>
</header>
