---
import { CartButton } from './CartButton';
---

<header class="bg-white shadow-sm sticky top-0 z-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <div class="flex items-center">
        <a href="/" class="flex-shrink-0 flex items-center gap-2">
          <svg class="h-8 w-8 text-black" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
          </svg>
          <span class="font-bold text-xl tracking-tight text-black">AstroStore</span>
        </a>
      </div>
      <div class="flex items-center space-x-4">
        <nav class="hidden md:flex space-x-8 mr-4">
          <a href="#" class="text-gray-500 hover:text-black font-medium">New Arrivals</a>
          <a href="#" class="text-gray-500 hover:text-black font-medium">Men</a>
          <a href="#" class="text-gray-500 hover:text-black font-medium">Women</a>
          <a href="#" class="text-gray-500 hover:text-black font-medium">Sale</a>
        </nav>
        <CartButton client:load />
      </div>
    </div>
  </div>
</header>
