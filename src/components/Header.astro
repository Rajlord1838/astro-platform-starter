---
import Logo from '../components/Logo.astro';
import CartIcon from './CartIcon.tsx';

const navItems = [
    { linkText: 'Home', href: '/' },
    { linkText: 'Shop', href: '/' },
];
---

<nav class="flex flex-wrap items-center justify-between gap-4 pt-6 pb-12 sm:pt-12 sm:pb-16 border-b border-gray-100 mb-8">
    <div class="flex items-center gap-8">
        <a href="/" class="text-2xl font-bold tracking-tighter">
            LUMIÈRE
        </a>
        {
            !!navItems?.length && (
                <ul class="hidden sm:flex flex-wrap gap-x-6 gap-y-1">
                    {navItems.map((item) => (
                        <li>
                            <a href={item.href} class="inline-block px-1.5 py-1 text-gray-600 hover:text-black font-medium transition-colors">
                                {item.linkText}
                            </a>
                        </li>
                    ))}
                </ul>
            )
        }
    </div>

    <div class="flex items-center gap-4">
        <button id="cart-drawer-trigger" class="p-2 text-gray-600 hover:text-black transition-colors" aria-label="Open Cart">
            <CartIcon client:load />
        </button>
    </div>
</nav>

<!-- Basic Cart Modal/Drawer implementation -->
<dialog id="cart-modal" class="p-0 rounded-lg shadow-xl backdrop:bg-black/50 backdrop:backdrop-blur-sm mx-auto my-auto md:mr-4 md:mt-24 md:mb-auto w-full max-w-lg border-0 open:flex flex-col">
    <div class="p-4 border-b border-gray-100 flex justify-between items-center bg-white sticky top-0 z-10">
        <h2 class="text-xl font-bold">Your Cart</h2>
        <form method="dialog">
            <button class="p-2 hover:bg-gray-100 rounded-full transition-colors" aria-label="Close cart">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" strokeWidth={1.5} stroke="currentColor" class="w-6 h-6">
                    <path strokeLinecap="round" strokeLinejoin="round" d="M6 18 18 6M6 6l12 12" />
                </svg>
            </button>
        </form>
    </div>
    <div class="p-4 overflow-y-auto max-h-[70vh]">
        <script>
            // Need to import Cart dynamically or render it on client to avoid hydration issues inside dialog
        </script>
        <div id="cart-root"></div>
    </div>
</dialog>

<script>
    // Handle dialog interactions
    const trigger = document.getElementById('cart-drawer-trigger');
    const modal = document.getElementById('cart-modal') as HTMLDialogElement;

    if (trigger && modal) {
        trigger.addEventListener('click', () => {
            modal.showModal();
        });

        // Close when clicking backdrop
        modal.addEventListener('click', (e) => {
            const dialogDimensions = modal.getBoundingClientRect();
            if (
                e.clientX < dialogDimensions.left ||
                e.clientX > dialogDimensions.right ||
                e.clientY < dialogDimensions.top ||
                e.clientY > dialogDimensions.bottom
            ) {
                modal.close();
            }
        });
    }
</script>

<script>
    import { createRoot } from 'react-dom/client';
    import React from 'react';
    import Cart from './Cart.tsx';

    // Mount the Cart React component when the page loads
    // This approach works around some dialog + client:load hydration quirks
    document.addEventListener('DOMContentLoaded', () => {
        const cartRoot = document.getElementById('cart-root');
        if (cartRoot) {
            const root = createRoot(cartRoot);
            root.render(React.createElement(Cart));
        }
    });
</script>
