---
import { CartIcon } from './Cart';

const navItems = [
    { linkText: 'Home', href: '/' }
];
---

<nav class="flex flex-wrap items-center justify-between gap-4 pt-6 pb-16 sm:pt-12 sm:pb-24">
    <div class="flex items-center gap-8">
        <a href="/" class="text-2xl font-bold uppercase tracking-widest text-black">
            Lumina
        </a>
        {
            !!navItems?.length && (
                <ul class="flex flex-wrap gap-x-4 gap-y-1">
                    {navItems.map((item) => (
                        <li>
                            <a href={item.href} class="inline-block px-1.5 py-1 sm:px-3 sm:py-2 text-gray-800 hover:text-black">
                                {item.linkText}
                            </a>
                        </li>
                    ))}
                </ul>
            )
        }
    </div>
    <div class="flex items-center text-black">
        <CartIcon client:load />
    </div>
</nav>
