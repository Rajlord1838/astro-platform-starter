---
import Cart from './Cart.tsx';
---

<header class="bg-gray-900 border-b border-gray-800 sticky top-0 z-40 w-full py-4 px-6 sm:px-12">
    <div class="flex items-center justify-between max-w-5xl mx-auto">
        <a href="/" class="flex items-center gap-2 group">
            <div class="w-10 h-10 bg-primary rounded flex items-center justify-center text-white font-bold text-xl group-hover:bg-primary/90 transition-colors">
                FS
            </div>
            <span class="text-xl font-bold text-white tracking-tight">FashionStore</span>
        </a>

        <nav class="hidden md:flex items-center gap-6">
            <a href="/" class="text-gray-300 hover:text-white transition-colors">Home</a>
            <a href="#" class="text-gray-300 hover:text-white transition-colors">Men</a>
            <a href="#" class="text-gray-300 hover:text-white transition-colors">Women</a>
            <a href="#" class="text-gray-300 hover:text-white transition-colors">Accessories</a>
        </nav>

        <div class="flex items-center gap-4">
            <Cart client:load />
        </div>
    </div>
</header>
