---
const navItems = [
    { linkText: 'Home', href: '/' },
    { linkText: 'Shop', href: '#' },
    { linkText: 'Collections', href: '#' },
    { linkText: 'About', href: '#' }
];
---

<nav class="flex flex-wrap items-center justify-between pt-6 pb-16 sm:pt-12 sm:pb-24">
    <a href="/">
        <span class="text-2xl font-bold tracking-tight">LUXE.</span>
    </a>
    {
        !!navItems?.length && (
            <ul class="flex flex-wrap gap-x-6 gap-y-1">
                {navItems.map((item) => (
                    <li>
                        <a href={item.href} class="inline-block px-1.5 py-1 sm:px-3 sm:py-2 hover:text-gray-600 transition-colors">
                            {item.linkText}
                        </a>
                    </li>
                ))}
            </ul>
        )
    }
</nav>
