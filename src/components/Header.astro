---
import Logo from '../components/Logo.astro';
import CartIcon from './CartIcon';
import CartContents from './CartContents';

const navItems = [
    { linkText: 'Shop', href: '/' },
    { linkText: 'New Arrivals', href: '#' },
    { linkText: 'Sale', href: '#' },
];
---

<nav class="flex flex-wrap items-center justify-between pt-6 pb-16 sm:pt-12 sm:pb-24 gap-4">
    <div class="flex items-center gap-8">
        <a href="/" class="flex items-center gap-2">
            <span class="text-2xl font-bold tracking-tighter">FashionStore</span>
        </a>
        {
            !!navItems?.length && (
                <ul class="hidden sm:flex flex-wrap gap-x-4 gap-y-1">
                    {navItems.map((item) => (
                        <li>
                            <a href={item.href} class="inline-block px-1.5 py-1 sm:px-3 sm:py-2 hover:text-gray-300 transition-colors">
                                {item.linkText}
                            </a>
                        </li>
                    ))}
                </ul>
            )
        }
    </div>

    <div>
        <CartIcon client:load />
    </div>

    <dialog id="cart-modal" class="backdrop:bg-black/50 bg-transparent m-auto p-0 rounded-lg max-w-md w-full focus:outline-none">
        <CartContents client:load />
    </dialog>
</nav>

<style>
    dialog::backdrop {
        background: rgba(0, 0, 0, 0.5);
    }
    dialog[open] {
        animation: scale-up 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @keyframes scale-up {
        0% {
            opacity: 0;
            transform: scale(0.95);
        }
        100% {
            opacity: 1;
            transform: scale(1);
        }
    }
</style>
