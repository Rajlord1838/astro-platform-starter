---
import Logo from '../components/Logo.astro';
import { CartHeader } from './CartHeader.tsx';

const navItems = [
    { linkText: 'Home', href: '/' },
    { linkText: 'New Arrivals', href: '#' },
    { linkText: 'Men', href: '#' },
    { linkText: 'Women', href: '#' },
    { linkText: 'Accessories', href: '#' }
];
---

<header class="w-full">
    <nav class="flex flex-wrap items-center justify-between py-6 sm:py-8 border-b border-gray-700/50 mb-12">
        <div class="flex items-center gap-8">
            <a href="/">
                <Logo />
            </a>
            {
                !!navItems?.length && (
                    <ul class="hidden sm:flex flex-wrap gap-x-6">
                        {navItems.map((item) => (
                            <li>
                                <a href={item.href} class="text-gray-200 hover:text-white font-medium transition-colors">
                                    {item.linkText}
                                </a>
                            </li>
                        ))}
                    </ul>
                )
            }
        </div>
        <div class="flex items-center">
            <CartHeader client:load />
        </div>
    </nav>
</header>
