---
import Logo from '../components/Logo.astro';
import CartIndicator from '../components/CartIndicator.tsx';

const navItems = [
    { linkText: 'Home', href: '/' },
    { linkText: 'Cart', href: '/cart' }
];
---

<nav class="flex flex-wrap items-center justify-between gap-4 pt-6 pb-16 sm:pt-12 sm:pb-24">
    <a href="/">
        <Logo />
    </a>
    <div class="flex items-center gap-6">
        {
            !!navItems?.length && (
                <ul class="flex flex-wrap gap-x-4 gap-y-1">
                    {navItems.map((item) => (
                        <li>
                            <a href={item.href} class="inline-block px-1.5 py-1 sm:px-3 sm:py-2 font-medium">
                                {item.linkText}
                            </a>
                        </li>
                    ))}
                </ul>
            )
        }
        <CartIndicator client:load />
    </div>
</nav>
