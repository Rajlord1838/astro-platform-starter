---
import Logo from '../components/Logo.astro';
import CartIcon from './CartIcon';

const navItems = [
    { linkText: 'Home', href: '/' },
    { linkText: 'Products', href: '/#products' },
];
---

<nav class="flex flex-wrap items-center justify-between gap-4 pt-6 pb-8 sm:pt-12 sm:pb-16">
    <div class="flex items-center gap-8">
        <a href="/" class="text-gray-900 flex items-center gap-2">
            <span class="text-2xl font-black tracking-tighter">VOGUE</span>
        </a>

        {
            !!navItems?.length && (
                <ul class="flex flex-wrap gap-x-6 gap-y-1">
                    {navItems.map((item) => (
                        <li>
                            <a href={item.href} class="inline-block py-2 text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors">
                                {item.linkText}
                            </a>
                        </li>
                    ))}
                </ul>
            )
        }
    </div>

    <div class="flex items-center">
        <CartIcon client:load />
    </div>
</nav>
