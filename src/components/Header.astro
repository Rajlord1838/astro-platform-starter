---
import Logo from '../components/Logo.astro';
import { HeaderCart } from './react/HeaderCart';

const navItems = [
    { linkText: 'Home', href: '/' },
    { linkText: 'New Arrivals', href: '#' },
    { linkText: 'Men', href: '#' },
    { linkText: 'Women', href: '#' },
    { linkText: 'Sale', href: '#' }
];
---

<header class="flex flex-wrap items-center justify-between gap-4 pt-6 pb-16 sm:pt-12 sm:pb-24">
    <nav class="flex items-center gap-8">
        <a href="/">
            <Logo />
        </a>
        {
            !!navItems?.length && (
                <ul class="flex flex-wrap gap-x-4 gap-y-1">
                    {navItems.map((item) => (
                        <li>
                            <a href={item.href} class="inline-block px-1.5 py-1 sm:px-3 sm:py-2">
                                {item.linkText}
                            </a>
                        </li>
                    ))}
                </ul>
            )
        }
    </nav>
    <div class="flex items-center">
        <HeaderCart client:load />
    </div>
</header>
