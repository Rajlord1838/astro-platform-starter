---
import Logo from '../components/Logo.astro';
import { CartBadge } from './shop/CartBadge';
---

<nav class="flex flex-wrap items-center justify-between gap-4 pt-6 pb-12 sm:pt-12 sm:pb-16 border-b border-white/10 mb-8">
    <a href="/" class="flex items-center gap-3 hover:opacity-80 transition-opacity">
        <Logo />
        <span class="text-2xl font-bold tracking-tight">Fashion Store</span>
    </a>

    <div class="flex items-center gap-6">
        <a href="/" class="font-medium hover:text-primary transition-colors">Shop</a>
        <CartBadge client:load />
    </div>
</nav>
