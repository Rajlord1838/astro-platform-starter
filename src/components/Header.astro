---
const navItems = [
    { linkText: 'Home', href: '/' },
    { linkText: 'Shop', href: '#' },
    { linkText: 'New Arrivals', href: '#' },
    { linkText: 'Sale', href: '#' }
];
---

<header class="flex flex-wrap items-center justify-between gap-4 pt-6 pb-8 sm:pt-8 sm:pb-12 border-b border-gray-200 mb-8 text-primary">
    <a href="/" class="text-2xl font-extrabold tracking-widest uppercase">
        Vogue<span class="text-accent">Style</span>
    </a>
    {
        !!navItems?.length && (
            <nav>
                <ul class="flex flex-wrap gap-x-6 gap-y-2 font-medium">
                    {navItems.map((item) => (
                        <li>
                            <a href={item.href} class="inline-block px-1.5 py-1 sm:px-2 sm:py-2 hover:text-accent transition-colors">
                                {item.linkText}
                            </a>
                        </li>
                    ))}
                </ul>
            </nav>
        )
    }
    <div class="flex items-center gap-4">
        <a href="#" class="hover:text-accent transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        </a>
        <a href="#" class="hover:text-accent transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
        </a>
        <a href="#" class="hover:text-accent transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
        </a>
    </div>
</header>
