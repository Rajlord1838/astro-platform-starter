---
import Logo from '../components/Logo.astro';
import { CartIcon } from './CartIcon';

const navItems = [
    { linkText: 'Home', href: '/' },
    { linkText: 'Shop', href: '/#shop' },
    { linkText: 'Categories', href: '/#categories' }
];
---

<nav class="flex flex-wrap items-center justify-between gap-4 pt-6 pb-16 sm:pt-12 sm:pb-24">
    <div class="flex items-center gap-8">
        <a href="/" class="flex items-center gap-2">
            <span class="text-2xl font-bold tracking-tight text-white">Lumina<span class="text-primary">Style</span></span>
        </a>
        {
            !!navItems?.length && (
                <ul class="hidden sm:flex flex-wrap gap-x-6 gap-y-1">
                    {navItems.map((item) => (
                        <li>
                            <a href={item.href} class="inline-block py-2 text-gray-300 hover:text-white transition-colors">
                                {item.linkText}
                            </a>
                        </li>
                    ))}
                </ul>
            )
        }
    </div>
    <div class="flex items-center">
        <CartIcon client:load />
    </div>
</nav>
