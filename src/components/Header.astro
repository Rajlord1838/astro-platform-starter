---
import Logo from '../components/Logo.astro';
import CartButton from './react/CartButton.tsx';

const navItems = [
    { linkText: 'New Arrivals', href: '#' },
    { linkText: 'Men', href: '#' },
    { linkText: 'Women', href: '#' },
    { linkText: 'Accessories', href: '#' }
];
---

<nav class="flex flex-wrap items-center justify-between gap-4 pt-6 pb-8 border-b border-gray-200 mb-8">
    <a href="/" class="text-gray-900 hover:opacity-100 flex items-center gap-2">
        <span class="text-2xl font-bold tracking-tighter">FASHION</span>
    </a>
    {
        !!navItems?.length && (
            <ul class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1">
                {navItems.map((item) => (
                    <li>
                        <a href={item.href} class="inline-block px-1.5 py-1 sm:px-3 sm:py-2 font-medium text-gray-600 hover:text-gray-900 no-underline transition-colors">
                            {item.linkText}
                        </a>
                    </li>
                ))}
            </ul>
        )
    }
    <div class="flex items-center ml-auto sm:ml-0">
        <CartButton client:load />
    </div>
</nav>
