---
const navItems = [
    { linkText: 'Home', href: '/' },
    { linkText: 'Women', href: '#' },
    { linkText: 'Men', href: '#' },
    { linkText: 'Accessories', href: '#' },
    { linkText: 'Sale', href: '#' }
];
---

<nav class="flex flex-wrap items-center justify-between gap-4 pt-6 pb-16 sm:pt-12 sm:pb-24">
    <a href="/" class="text-2xl font-bold tracking-widest uppercase">
        FashionHub
    </a>
    {
        !!navItems?.length && (
            <ul class="flex flex-wrap gap-x-4 gap-y-1">
                {navItems.map((item) => (
                    <li>
                        <a href={item.href} class="inline-block px-1.5 py-1 sm:px-3 sm:py-2 hover:text-gray-500 transition-colors">
                            {item.linkText}
                        </a>
                    </li>
                ))}
            </ul>
        )
    }
</nav>
