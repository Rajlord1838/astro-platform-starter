---
import { CartIcon } from '../components/react/CartIcon';

const navItems = [
    { linkText: 'Home', href: '/' },
    { linkText: 'Shop', href: '#' },
    { linkText: 'Collections', href: '#' },
    { linkText: 'About', href: '#' }
];
---

<nav class="flex flex-wrap items-center justify-between py-6 border-b border-gray-200">
    <div class="flex items-center gap-8">
        <a href="/" class="text-gray-900" aria-label="Home">
            <span class="text-2xl font-bold tracking-tighter">FASHION<span class="font-light">STORE</span></span>
        </a>
        {
            !!navItems?.length && (
                <ul class="hidden md:flex flex-wrap gap-x-8">
                    {navItems.map((item) => (
                        <li>
                            <a href={item.href} class="text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors">
                                {item.linkText}
                            </a>
                        </li>
                    ))}
                </ul>
            )
        }
    </div>

    <div class="flex items-center gap-4">
        <div class="text-gray-900 p-2 rounded-full hover:bg-gray-100 transition-colors cursor-pointer">
            <CartIcon client:load />
        </div>
    </div>
</nav>