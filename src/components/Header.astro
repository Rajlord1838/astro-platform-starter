---
import CartIcon from './CartIcon';

const navItems = [
    { linkText: 'Home', href: '/' },
    { linkText: 'Men', href: '#' },
    { linkText: 'Women', href: '#' },
    { linkText: 'Accessories', href: '#' },
];
---

<header class="flex items-center justify-between py-6 mb-12 border-b border-gray-200">
    <div class="flex items-center gap-8">
        <a href="/" class="text-2xl font-bold tracking-tighter">
            FASHION<span class="text-gray-500">STORE</span>
        </a>
        {
            !!navItems?.length && (
                <nav class="hidden md:block">
                    <ul class="flex gap-6">
                        {navItems.map((item) => (
                            <li>
                                <a href={item.href} class="text-sm font-medium text-gray-600 hover:text-black transition-colors">
                                    {item.linkText}
                                </a>
                            </li>
                        ))}
                    </ul>
                </nav>
            )
        }
    </div>
    <div class="flex items-center gap-4">
        <CartIcon client:load />
    </div>
</header>
