---
import Logo from '../components/Logo.astro';
import { CartModal } from './react/CartModal';

const navItems = [
    { linkText: 'Home', href: '/' },
    { linkText: 'Shop', href: '#' },
    { linkText: 'About', href: '#' }
];
---

<nav class="flex flex-wrap items-center justify-between pt-6 pb-16 sm:pt-12 sm:pb-24">
    <div class="flex items-center gap-8">
        <a href="/">
            <Logo />
        </a>
        {
            !!navItems?.length && (
                <ul class="flex flex-wrap gap-x-4 gap-y-1">
                    {navItems.map((item) => (
                        <li>
                            <a href={item.href} class="inline-block px-1.5 py-1 sm:px-3 sm:py-2 font-medium hover:text-primary transition-colors">
                                {item.linkText}
                            </a>
                        </li>
                    ))}
                </ul>
            )
        }
    </div>

    <div>
        <CartModal client:load />
    </div>
</nav>
