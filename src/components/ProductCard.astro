---
import type { Product } from '../data/products';
import AddToCartButton from './AddToCartButton.tsx';

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<div class="group flex flex-col bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden transition-shadow hover:shadow-md">
  <div class="aspect-h-1 aspect-w-1 w-full overflow-hidden bg-gray-200 xl:aspect-h-8 xl:aspect-w-7">
    <img
      src={product.imageUrl}
      alt={product.name}
      class="h-64 w-full object-cover object-center group-hover:opacity-75 transition-opacity"
    />
  </div>
  <div class="flex flex-col flex-grow p-4">
    <div class="flex justify-between items-start mb-2">
      <h3 class="text-lg font-medium text-gray-900">{product.name}</h3>
      <p class="text-lg font-bold text-gray-900">${product.price.toFixed(2)}</p>
    </div>
    <p class="mt-1 text-sm text-gray-500 mb-4 flex-grow">{product.description}</p>

    <div class="mt-auto">
      <AddToCartButton client:load product={product} />
    </div>
  </div>
</div>
