---
import type { Product } from '../types';
import { AddToCartButton } from './react/AddToCartButton';

interface Props {
    product: Product;
}

const { product } = Astro.props;
---

<div class="group flex flex-col bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow duration-300 overflow-hidden border border-gray-100">
    <div class="relative aspect-[4/5] overflow-hidden bg-gray-100">
        <img
            src={product.image}
            alt={product.name}
            class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
            loading="lazy"
        />
        <div class="absolute top-3 left-3">
            <span class="px-2.5 py-1 text-xs font-semibold bg-white/90 text-gray-800 rounded-full shadow-sm backdrop-blur-sm">
                {product.category}
            </span>
        </div>
    </div>

    <div class="flex flex-col flex-grow p-5">
        <div class="flex justify-between items-start mb-2 gap-4">
            <h3 class="text-lg font-bold text-gray-900 leading-tight">
                {product.name}
            </h3>
            <span class="text-lg font-bold text-primary shrink-0">
                ${product.price.toFixed(2)}
            </span>
        </div>

        <p class="text-gray-500 text-sm mb-6 flex-grow line-clamp-2">
            {product.description}
        </p>

        <div class="mt-auto">
            <AddToCartButton product={product} client:load />
        </div>
    </div>
</div>
