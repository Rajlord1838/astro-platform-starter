---
interface Props {
    title: string;
    price: string;
    imageUrl: string;
    category?: string;
}

const { title, price, imageUrl, category } = Astro.props;
---

<div class="group relative flex flex-col overflow-hidden rounded-lg bg-white shadow-md transition-shadow hover:shadow-lg">
    <div class="aspect-h-4 aspect-w-3 bg-gray-200 sm:aspect-none sm:h-96">
        <img
            src={imageUrl}
            alt={title}
            class="h-full w-full object-cover object-center sm:h-full sm:w-full transition-transform duration-300 group-hover:scale-105"
        />
    </div>
    <div class="flex flex-1 flex-col space-y-2 p-4">
        {category && <p class="text-sm italic text-gray-500">{category}</p>}
        <h3 class="text-sm font-medium text-gray-900 line-clamp-2">
            <a href="#">
                <span aria-hidden="true" class="absolute inset-0"></span>
                {title}
            </a>
        </h3>
        <p class="text-base font-semibold text-gray-900 mt-auto pt-2">{price}</p>

        <button class="mt-4 w-full bg-gray-900 text-white py-2 px-4 rounded hover:bg-gray-800 transition-colors z-10 relative cursor-pointer">
            Add to Cart
        </button>
    </div>
</div>
