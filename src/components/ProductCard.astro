---
import type { Product } from '../types';
import AddToCartButton from './react/AddToCartButton';

interface Props {
    product: Product;
}

const { product } = Astro.props;
---

<div class="bg-gray-900 rounded-lg overflow-hidden shadow-lg border border-gray-800 flex flex-col h-full transition-transform hover:-translate-y-1">
    <div class="relative pt-[133%]">
        <img
            src={product.image}
            alt={product.name}
            class="absolute top-0 left-0 w-full h-full object-cover"
            loading="lazy"
        />
        <div class="absolute top-2 left-2 bg-primary/90 text-primary-content text-xs font-bold px-2 py-1 rounded">
            {product.category}
        </div>
    </div>

    <div class="p-4 flex flex-col flex-1">
        <h3 class="text-lg font-bold mb-1 truncate" title={product.name}>{product.name}</h3>
        <p class="text-gray-400 text-sm mb-4 line-clamp-2">{product.description}</p>

        <div class="mt-auto pt-4 border-t border-gray-800 flex items-center justify-between">
            <span class="text-xl font-bold text-primary">${product.price.toFixed(2)}</span>
            <div class="w-32">
                <AddToCartButton product={product} client:load />
            </div>
        </div>
    </div>
</div>
