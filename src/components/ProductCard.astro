---
interface Props {
    title: string;
    price: string;
    image: string;
}

const { title, price, image } = Astro.props;
---

<a href="#" class="group block">
    <div class="aspect-h-1 aspect-w-1 w-full overflow-hidden rounded-lg bg-gray-200 xl:aspect-h-8 xl:aspect-w-7">
        <img
            src={image}
            alt={title}
            class="h-full w-full object-cover object-center group-hover:opacity-75 transition-opacity"
            loading="lazy"
        />
    </div>
    <h3 class="mt-4 text-sm text-gray-700">{title}</h3>
    <p class="mt-1 text-lg font-medium text-gray-900">{price}</p>
</a>
