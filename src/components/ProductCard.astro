---
import type { Product } from '../types';
import AddToCartButton from './react/AddToCartButton';

interface Props {
    product: Product;
}

const { product } = Astro.props;
---

<div class="flex flex-col bg-gray-900 rounded-xl overflow-hidden shadow-lg border border-gray-800 transition-transform hover:-translate-y-1 hover:shadow-xl">
    <div class="relative h-64 overflow-hidden bg-gray-800">
        <img
            src={product.image}
            alt={product.name}
            class="object-cover w-full h-full"
            loading="lazy"
        />
        <div class="absolute top-2 right-2">
            <span class="px-2 py-1 text-xs font-semibold text-white bg-black/50 backdrop-blur-sm rounded-full">
                {product.category}
            </span>
        </div>
    </div>

    <div class="flex flex-col flex-1 p-5">
        <div class="flex justify-between items-start mb-2 gap-2">
            <h3 class="text-lg font-bold text-white line-clamp-1">{product.name}</h3>
            <span class="text-lg font-bold text-primary whitespace-nowrap">${product.price}</span>
        </div>

        <p class="text-sm text-gray-400 mb-4 flex-1 line-clamp-2">{product.description}</p>

        <div class="mt-auto">
            <AddToCartButton product={product} client:load />
        </div>
    </div>
</div>
