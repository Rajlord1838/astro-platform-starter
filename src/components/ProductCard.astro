---
import type { Product } from '../types';
import { AddToCartButton } from './AddToCartButton';

interface Props {
    product: Product;
}

const { product } = Astro.props;
---

<div class="flex flex-col overflow-hidden rounded-xl bg-black/20 border border-gray-800 transition-all hover:border-gray-600 hover:bg-black/30 group">
    <div class="relative aspect-square overflow-hidden bg-gray-900">
        <img
            src={product.image}
            alt={product.name}
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
        />
        {product.category && (
            <span class="absolute top-4 left-4 rounded-full bg-black/60 px-3 py-1 text-xs font-medium backdrop-blur-md">
                {product.category}
            </span>
        )}
    </div>
    <div class="flex flex-col flex-1 p-6">
        <div class="flex justify-between items-start gap-4 mb-2">
            <h3 class="text-xl font-bold leading-tight">{product.name}</h3>
            <span class="text-xl font-bold text-primary shrink-0">${product.price.toFixed(2)}</span>
        </div>
        <p class="text-gray-400 text-sm mb-6 flex-1 line-clamp-2">{product.description}</p>
        <div class="mt-auto">
            <AddToCartButton product={product} client:load />
        </div>
    </div>
</div>
