---
import type { Product } from '../data/products';
import AddToCartButton from './AddToCartButton';

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<div class="flex flex-col bg-gray-900 rounded-lg overflow-hidden shadow-lg border border-gray-800 transition-transform hover:scale-[1.02]">
  <div class="relative h-64 overflow-hidden">
    <img
      src={product.image}
      alt={product.name}
      class="object-cover w-full h-full"
    />
  </div>

  <div class="flex flex-col flex-grow p-5">
    <div class="flex justify-between items-start mb-2">
      <h3 class="text-xl font-bold text-white leading-tight">{product.name}</h3>
      <span class="text-lg font-semibold text-primary ml-4">${product.price.toFixed(2)}</span>
    </div>

    <p class="text-gray-400 text-sm mb-6 flex-grow">{product.description}</p>

    <div class="mt-auto">
      <AddToCartButton client:load product={product} />
    </div>
  </div>
</div>
