---
import type { Product } from '../types';
import AddToCartButton from './react/AddToCartButton';

interface Props {
    product: Product;
}

const { product } = Astro.props;
---

<div class="group flex flex-col overflow-hidden rounded-lg border border-border bg-white shadow-sm transition-shadow hover:shadow-md text-gray-900">
    <div class="relative aspect-[3/4] overflow-hidden bg-gray-100">
        <img
            src={product.imageUrl}
            alt={product.name}
            class="h-full w-full object-cover object-center transition-transform duration-300 group-hover:scale-105"
            loading="lazy"
        />
        <div class="absolute top-2 right-2 rounded-full bg-white/90 px-2 py-1 text-xs font-semibold text-gray-800 shadow-sm backdrop-blur-sm">
            {product.category}
        </div>
    </div>
    <div class="flex flex-1 flex-col p-4">
        <div class="flex items-start justify-between gap-2">
            <div>
                <h3 class="font-bold text-lg leading-tight line-clamp-1">{product.name}</h3>
                <p class="mt-1 text-sm text-gray-500 line-clamp-2">{product.description}</p>
            </div>
            <span class="font-bold whitespace-nowrap text-lg text-primary">${product.price.toFixed(2)}</span>
        </div>
        <div class="mt-auto pt-4">
            <AddToCartButton product={product} client:load />
        </div>
    </div>
</div>
