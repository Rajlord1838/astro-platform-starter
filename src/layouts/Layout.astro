---
import '../styles/globals.css';
import Header from '../components/react/Header';
import Cart from '../components/react/Cart';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="A modern fashion store built with Astro and React" />
  </head>
  <body class="min-h-screen bg-gray-50 flex flex-col">
    <Header client:load />

    <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <slot />
    </main>

    <footer class="bg-white border-t py-8 mt-auto">
      <div class="container mx-auto px-4 text-center text-gray-500 text-sm">
        &copy; {new Date().getFullYear()} VogueStore. All rights reserved.
      </div>
    </footer>

    <Cart client:load />
  </body>
</html>
