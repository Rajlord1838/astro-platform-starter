---
import '../../src/styles/globals.css';
import '@fontsource-variable/inter/wght.css';
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import Footer from '../components/Footer.astro';
import { CartButton } from '../components/react/CartButton';
import { Cart } from '../components/react/Cart';

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <title>{title}</title>
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="preload" as="font" type="font/woff2" href={interWoff2} crossorigin />
    </head>
    <body class="antialiased text-gray-900 bg-gray-50">
        <div class="flex flex-col min-h-screen px-6 sm:px-12">
            <div class="flex flex-col w-full max-w-7xl mx-auto grow">
                <header class="flex items-center justify-between py-6 border-b border-gray-200 mb-8">
                    <a href="/" class="text-2xl font-black tracking-tighter">
                        FASHION<span class="text-red-600">STORE</span>
                    </a>
                    <nav class="flex gap-6 items-center">
                        <a href="/" class="text-sm font-semibold text-gray-700 hover:text-black transition-colors">Home</a>
                        <a href="#" class="text-sm font-semibold text-gray-700 hover:text-black transition-colors">Men</a>
                        <a href="#" class="text-sm font-semibold text-gray-700 hover:text-black transition-colors">Women</a>
                        <div class="ml-4 pl-4 border-l border-gray-200">
                            <CartButton client:load />
                        </div>
                    </nav>
                </header>
                <main class="grow"><slot /></main>
                <Footer />
            </div>
        </div>
        <Cart client:load />
    </body>
</html>
