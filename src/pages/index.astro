---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProductCard from '../components/ProductCard';
import Cart from '../components/Cart';
import { mockProducts } from '../utils/mockData';
---

<Layout title="Fashion Store - Discover Your Style">
    <Hero />

    <div id="shop" class="mb-16 scroll-mt-24">
        <div class="flex justify-between items-end mb-8">
            <div>
                <h2 class="text-3xl font-bold mb-2">Featured Products</h2>
                <p class="text-gray-400">Handpicked selections just for you.</p>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
            {mockProducts.map((product) => (
                <ProductCard product={product} client:load />
            ))}
        </div>
    </div>

    <Cart client:load />
</Layout>
