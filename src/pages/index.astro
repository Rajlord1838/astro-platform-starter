---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.tsx';
import { products } from '../data/products.ts';
---

<Layout title="Fashion Store - Discover the Latest Trends">
    <div class="mb-12 text-center sm:text-left">
        <h1 class="mb-4 text-4xl font-bold tracking-tight text-white sm:text-5xl">New Arrivals</h1>
        <p class="text-lg text-neutral-400 max-w-2xl">
            Explore our latest collection of premium clothing and accessories.
            Designed for comfort, crafted for style.
        </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 mb-16">
        {products.map((product) => (
            <ProductCard product={product} client:load />
        ))}
    </div>
</Layout>
