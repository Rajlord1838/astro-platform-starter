---
import Layout from '../layouts/Layout.astro';
import { products } from '../utils/products';
import { AddToCartButton } from '../components/AddToCartButton';

---

<Layout title="Fashion Store - Shop">
    <div class="mb-12">
        <h1 class="mb-4">New Arrivals</h1>
        <p class="text-xl text-gray-300">Discover our latest collection of premium fashion.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
        {products.map((product) => (
            <div class="bg-gray-800/50 rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-shadow flex flex-col">
                <div class="aspect-[4/5] relative overflow-hidden bg-gray-900">
                    <img
                        src={product.imageUrl}
                        alt={product.name}
                        class="object-cover w-full h-full hover:scale-105 transition-transform duration-300"
                        loading="lazy"
                    />
                    <div class="absolute top-4 left-4 bg-primary text-white text-xs font-bold px-2 py-1 rounded">
                        {product.category}
                    </div>
                </div>

                <div class="p-6 flex flex-col flex-grow">
                    <div class="flex justify-between items-start mb-2 gap-4">
                        <h2 class="text-xl font-bold line-clamp-2">{product.name}</h2>
                        <span class="text-lg font-bold text-primary whitespace-nowrap">${product.price.toFixed(2)}</span>
                    </div>

                    <p class="text-gray-400 text-sm mb-6 flex-grow">{product.description}</p>

                    <div class="mt-auto">
                        <AddToCartButton client:load product={product} />
                    </div>
                </div>
            </div>
        ))}
    </div>
</Layout>
