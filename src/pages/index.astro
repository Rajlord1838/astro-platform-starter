---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/products';
---

<Layout title="Luxe Fashion | Modern Minimalist Clothing">
    <section class="mb-20 pt-10">
        <div class="relative overflow-hidden rounded-3xl bg-black/40 border border-gray-800 p-8 sm:p-16 flex flex-col md:flex-row items-center gap-10">
            <div class="flex-1 space-y-6">
                <span class="text-primary font-semibold tracking-wider uppercase text-sm">New Collection 2024</span>
                <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight">Elevate Your <br/><span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-purple-400">Everyday Style</span></h1>
                <p class="text-gray-300 text-lg max-w-xl">Discover our latest arrivals. Thoughtfully designed clothing that blends comfort with contemporary aesthetics.</p>
                <div class="pt-4">
                    <a href="#shop" class="btn btn-lg sm:min-w-48 bg-primary hover:bg-primary/90 text-white rounded-full">Shop Now</a>
                </div>
            </div>
            <div class="flex-1 w-full relative">
                <div class="aspect-[4/3] rounded-2xl overflow-hidden shadow-2xl">
                    <img
                        src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&q=80&w=1200"
                        alt="Fashion Collection Hero"
                        class="w-full h-full object-cover"
                    />
                </div>
                <div class="absolute -bottom-6 -left-6 w-32 h-32 bg-primary/20 blur-3xl rounded-full"></div>
                <div class="absolute -top-6 -right-6 w-40 h-40 bg-purple-500/20 blur-3xl rounded-full"></div>
            </div>
        </div>
    </section>

    <section id="shop" class="mb-24 scroll-mt-24">
        <div class="flex justify-between items-end mb-10 border-b border-gray-800 pb-4">
            <div>
                <h2 class="text-3xl font-bold">Featured Products</h2>
                <p class="text-gray-400 mt-2">Curated essentials for your wardrobe</p>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
            {products.map((product) => (
                <ProductCard product={product} />
            ))}
        </div>
    </section>
</Layout>
