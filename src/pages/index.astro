---
import Layout from '../layouts/Layout.astro';
import { products } from '../data/products';

const featuredProducts = products.slice(0, 3);
---

<Layout title="Home - Fashion Store">
    <section class="py-20 text-center">
        <h1 class="mb-6 text-5xl font-bold">Welcome to Fashion Store</h1>
        <p class="mb-10 text-xl text-gray-300">Discover the latest trends in clothing and accessories.</p>
        <a href="/shop" class="btn btn-lg sm:min-w-64 bg-primary text-white hover:bg-primary-dark">Shop Now</a>
    </section>

    <section class="py-16">
        <h2 class="mb-10 text-3xl font-bold text-center">Featured Products</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
            {featuredProducts.map((product) => (
                <div class="bg-gray-800 rounded-lg overflow-hidden shadow-lg transition-transform hover:-translate-y-1">
                    <a href={`/product/${product.id}`}>
                        <img src={product.image} alt={product.name} class="w-full h-80 object-cover" />
                        <div class="p-6">
                            <h3 class="text-xl font-semibold mb-2">{product.name}</h3>
                            <p class="text-gray-400 mb-4">${product.price.toFixed(2)}</p>
                            <p class="text-primary hover:underline">View Details &rarr;</p>
                        </div>
                    </a>
                </div>
            ))}
        </div>
        <div class="mt-12 text-center">
             <a href="/shop" class="inline-block px-6 py-3 border border-primary text-primary hover:bg-primary hover:text-white transition-colors rounded-md">View All Products</a>
        </div>
    </section>
</Layout>
