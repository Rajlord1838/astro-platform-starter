---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ProductCard from '../components/ProductCard';
import Cart from '../components/Cart';
import { products } from '../utils/products';
---

<Layout title="Fashion Store - Latest Trends">
    <Header />
    <Cart client:load />

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="mb-12">
            <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl">New Arrivals</h1>
            <p class="mt-4 text-xl text-gray-500">Discover the latest trends in fashion and upgrade your wardrobe with our premium collection.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-y-10 gap-x-6 xl:gap-x-8">
            {products.map((product) => (
                <ProductCard product={product} client:load />
            ))}
        </div>
    </main>

    <footer class="bg-gray-50 border-t border-gray-200 mt-24">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
            <p class="text-center text-sm text-gray-500">
                &copy; 2024 FashionStore, Inc. All rights reserved.
            </p>
        </div>
    </footer>
</Layout>
