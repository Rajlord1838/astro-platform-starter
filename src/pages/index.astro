---
import Layout from '../layouts/Layout.astro';
import { ProductCard } from '../components/ProductCard';
import { products } from '../data/products';

---

<Layout title="Fashion Hub - Discover Your Style">
    <div class="mb-12 text-center">
        <h1 class="mb-4 text-4xl font-extrabold tracking-tight sm:text-5xl lg:text-6xl text-white">
            Discover Your Unique Style
        </h1>
        <p class="mx-auto max-w-2xl text-lg text-gray-300">
            Explore our curated collection of fashion essentials. From classic staples to trendy statement pieces, we have everything you need to elevate your wardrobe.
        </p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((product) => (
            <ProductCard client:load product={product} />
        ))}
    </div>
</Layout>
