---
import Layout from '../layouts/Layout.astro';
import { products } from '../data/products';
import AddToCartButton from '../components/react/AddToCartButton';
---

<Layout title="Fashion Store">
    <h1 class="mb-10 text-center">New Arrivals</h1>

    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((product) => (
            <div class="flex flex-col p-4 transition-transform border rounded-lg bg-white/5 border-white/10 hover:scale-[1.02]">
                <img
                    src={product.image}
                    alt={product.name}
                    class="object-cover w-full h-64 mb-4 rounded-md"
                />
                <div class="flex-1">
                    <div class="flex items-start justify-between gap-2">
                        <h2 class="text-xl font-semibold m-0">{product.name}</h2>
                        <span class="text-lg font-bold">${product.price.toFixed(2)}</span>
                    </div>
                    <p class="mt-1 text-sm text-gray-400">{product.category}</p>
                    <p class="mt-2 text-sm text-gray-300">{product.description}</p>
                </div>
                <div class="mt-auto">
                    <AddToCartButton product={product} client:load />
                </div>
            </div>
        ))}
    </div>
</Layout>
