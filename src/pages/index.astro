---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import ProductCard from '../components/ProductCard';
import { products } from '../utils/products';
---

<Layout title="FashionStore - Modern Fashion">
    <Header client:load />

    <main>
        {/* Hero Section */}
        <div className="relative bg-gray-900">
            <div aria-hidden="true" className="absolute inset-0 overflow-hidden">
                <img
                    src="https://images.unsplash.com/photo-1445205170230-053b83016050?auto=format&fit=crop&q=80&w=2000"
                    alt="Fashion background"
                    className="w-full h-full object-center object-cover opacity-50"
                />
            </div>
            <div className="relative max-w-7xl mx-auto py-24 px-4 sm:py-32 sm:px-6 lg:px-8 flex flex-col items-center text-center">
                <h1 className="text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl">
                    Summer Collection 2024
                </h1>
                <p className="mt-6 text-xl text-gray-300 max-w-3xl">
                    Discover our latest arrivals featuring premium materials and modern designs.
                    Elevate your everyday style with our carefully curated pieces.
                </p>
                <div className="mt-10">
                    <a
                        href="#collection"
                        className="inline-block bg-white border border-transparent rounded-md py-3 px-8 text-base font-medium text-gray-900 hover:bg-gray-100"
                    >
                        Shop Now
                    </a>
                </div>
            </div>
        </div>

        {/* Product Grid */}
        <div id="collection" className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
            <div className="md:flex md:items-center md:justify-between mb-8">
                <h2 className="text-2xl font-extrabold tracking-tight text-gray-900">Trending Now</h2>
                <a href="#" className="hidden text-sm font-medium text-indigo-600 hover:text-indigo-500 md:block">
                    Shop the collection<span aria-hidden="true"> &rarr;</span>
                </a>
            </div>

            <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-y-10 gap-x-6 xl:gap-x-8">
                {products.map((product) => (
                    <ProductCard client:load product={product} />
                ))}
            </div>

            <div className="mt-8 text-sm md:hidden">
                <a href="#" className="font-medium text-indigo-600 hover:text-indigo-500">
                    Shop the collection<span aria-hidden="true"> &rarr;</span>
                </a>
            </div>
        </div>
    </main>
</Layout>
