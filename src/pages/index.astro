---
import Layout from '../layouts/Layout.astro';
import ProductGrid from '../components/ProductGrid';
import { products } from '../data/products';
---

<Layout title="Fashion Store - Latest Collection">
    <div class="mb-12">
        <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl md:text-6xl text-center mb-4">
            Welcome to <span class="text-indigo-600">Fashion</span> Store
        </h1>
        <p class="mt-3 max-w-md mx-auto text-base text-gray-500 sm:text-lg md:mt-5 md:text-xl md:max-w-3xl text-center">
            Discover our latest collection of premium clothing and accessories. Carefully curated for your everyday style.
        </p>
    </div>

    <ProductGrid products={products} client:load />
</Layout>
