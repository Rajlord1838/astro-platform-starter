---
import Layout from '../layouts/Layout.astro';
import { ProductCard } from '../components/ProductCard';
import { products } from '../data/products';

// Group products by category (optional, for sections)
const featuredProducts = products.slice(0, 4);
---

<Layout title="FashionStore - Trendy Clothes & Accessories">
    <!-- Hero Section -->
    <section class="relative bg-white rounded-2xl overflow-hidden mb-16 shadow-lg">
        <div class="absolute inset-0 z-0">
            <img
                src="https://images.unsplash.com/photo-1445205170230-053b83016050?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2071&q=80"
                alt="Fashion Header"
                class="w-full h-full object-cover opacity-80"
            />
            <div class="absolute inset-0 bg-gradient-to-r from-black/70 to-transparent"></div>
        </div>

        <div class="relative z-10 p-10 md:p-16 max-w-2xl text-white">
            <span class="inline-block px-3 py-1 bg-primary text-sm font-bold rounded-full mb-4">New Collection</span>
            <h1 class="text-4xl md:text-5xl font-bold mb-4 leading-tight">Elevate Your Everyday Style</h1>
            <p class="text-lg text-gray-200 mb-8 max-w-lg">
                Discover our latest arrivals featuring premium fabrics and contemporary designs for the modern wardrobe.
            </p>
            <a href="#collection" class="btn btn-lg inline-block">Shop Now</a>
        </div>
    </section>

    <!-- Products Collection -->
    <section id="collection" class="mb-16">
        <div class="flex items-center justify-between mb-8">
            <h2 class="text-3xl font-bold">Latest Arrivals</h2>
            <a href="#" class="text-primary hover:underline font-medium">View All →</a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
            {products.map((product) => (
                <ProductCard client:load product={product} />
            ))}
        </div>
    </section>

    <!-- Features -->
    <section class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
        <div class="bg-gray-800/50 p-6 rounded-xl border border-gray-700 text-center">
            <div class="w-12 h-12 bg-primary/20 text-primary rounded-full flex items-center justify-center mx-auto mb-4 text-xl">🚚</div>
            <h3 class="font-bold text-lg mb-2">Free Shipping</h3>
            <p class="text-gray-400 text-sm">On all orders over $100</p>
        </div>
        <div class="bg-gray-800/50 p-6 rounded-xl border border-gray-700 text-center">
            <div class="w-12 h-12 bg-primary/20 text-primary rounded-full flex items-center justify-center mx-auto mb-4 text-xl">↩️</div>
            <h3 class="font-bold text-lg mb-2">Easy Returns</h3>
            <p class="text-gray-400 text-sm">30-day money back guarantee</p>
        </div>
        <div class="bg-gray-800/50 p-6 rounded-xl border border-gray-700 text-center">
            <div class="w-12 h-12 bg-primary/20 text-primary rounded-full flex items-center justify-center mx-auto mb-4 text-xl">🔒</div>
            <h3 class="font-bold text-lg mb-2">Secure Payment</h3>
            <p class="text-gray-400 text-sm">100% secure checkout</p>
        </div>
    </section>
</Layout>
