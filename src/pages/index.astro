---
import Layout from '../layouts/Layout.astro';
import { products } from '../utils/data';

const featuredProducts = products.slice(0, 3);
---

<Layout title="Aura Fashion - Home">
    <div class="flex flex-col gap-12">
        <section class="text-center py-20 bg-gray-50 rounded-2xl">
            <h1 class="text-5xl font-bold mb-6">Discover Your Style</h1>
            <p class="text-xl text-gray-600 mb-8 max-w-2xl mx-auto">
                Explore our latest collection of premium fashion pieces designed for comfort and elegance.
            </p>
            <a href="/products" class="inline-block px-8 py-3 bg-gray-900 text-white font-semibold rounded hover:bg-gray-800 transition-colors">
                Shop Now
            </a>
        </section>

        <section>
            <h2 class="text-3xl font-bold mb-8">Featured Products</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                {featuredProducts.map(product => (
                    <a href={`/product/${product.id}`} class="group block">
                        <div class="aspect-[3/4] overflow-hidden rounded-lg mb-4 bg-gray-100">
                            <img
                                src={product.image}
                                alt={product.name}
                                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                            />
                        </div>
                        <h3 class="text-lg font-semibold group-hover:text-gray-600 transition-colors">{product.name}</h3>
                        <p class="text-gray-600">${product.price.toFixed(2)}</p>
                    </a>
                ))}
            </div>
            <div class="text-center mt-12">
                <a href="/products" class="inline-block px-6 py-2 border border-gray-900 text-gray-900 font-semibold rounded hover:bg-gray-900 hover:text-white transition-colors">
                    View All Products
                </a>
            </div>
        </section>
    </div>
</Layout>
