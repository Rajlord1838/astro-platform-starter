---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/products';
---

<Layout title="Fashion Store - Modern Clothing & Accessories">
    <div class="mb-12 text-center md:text-left">
        <h1 class="text-4xl md:text-6xl font-bold mb-4">Discover Your Style</h1>
        <p class="text-lg md:text-xl text-white/80 max-w-2xl">
            Explore our curated collection of modern fashion. From everyday essentials to statement pieces, find exactly what you're looking for.
        </p>
    </div>

    <section aria-labelledby="products-heading">
        <h2 id="products-heading" class="text-2xl md:text-3xl font-bold mb-8">New Arrivals</h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8 mb-16">
            {products.map(product => (
                <ProductCard product={product} />
            ))}
        </div>
    </section>
</Layout>
