---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.tsx';
import CartProvider from '../components/CartProvider.tsx';
import { products } from '../data/products';
---

<Layout title="Astro Fashion Store">
    <div class="mb-12 text-center">
        <h1 class="mb-4">New Arrivals</h1>
        <p class="text-gray-400 text-lg max-w-2xl mx-auto">
            Discover our latest collection of premium clothing and accessories. Designed for comfort, styled for you.
        </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
        {products.map((product) => (
            <ProductCard product={product} client:load />
        ))}
    </div>

    <!-- Provider for the cart modal (React Island) -->
    <CartProvider client:load />
</Layout>
