---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/react/ProductCard';
import { products } from '../data/products';
---

<Layout title="Fashion Store - Latest Trends">
    <div class="mb-12 text-center">
        <h1 class="text-4xl sm:text-5xl font-extrabold mb-4">Summer Collection <span class="text-primary">2024</span></h1>
        <p class="text-lg text-gray-300 max-w-2xl mx-auto">Discover the latest trends in fashion. Quality materials, comfortable fits, and modern styles for every occasion.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {products.map(product => (
            <ProductCard client:only="react" product={product} />
        ))}
    </div>
</Layout>
