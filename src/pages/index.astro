---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/react/ProductCard';
import CartModal from '../components/react/CartModal';
import { products } from '../data/products';

const menProducts = products.filter(p => p.category === 'men');
const womenProducts = products.filter(p => p.category === 'women');
const kidsProducts = products.filter(p => p.category === 'kids');
---

<Layout title="Fashion Store">
    <div className="mb-16">
        <div className="text-center py-16 mb-12 bg-gradient-to-r from-gray-900 to-gray-800 rounded-2xl border border-gray-800">
            <h1 className="text-4xl md:text-5xl font-extrabold text-white mb-4">Welcome to Fashion Store</h1>
            <p className="text-xl text-gray-400 max-w-2xl mx-auto">Discover our latest collection of premium clothing for everyone.</p>
        </div>

        <section id="men" className="mb-16 scroll-mt-24">
            <div className="flex items-center justify-between mb-8 border-b border-gray-800 pb-4">
                <h2 className="text-3xl font-bold text-white">Men's Collection</h2>
            </div>
            <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                {menProducts.map(product => (
                    <ProductCard client:load product={product} />
                ))}
            </div>
        </section>

        <section id="women" className="mb-16 scroll-mt-24">
            <div className="flex items-center justify-between mb-8 border-b border-gray-800 pb-4">
                <h2 className="text-3xl font-bold text-white">Women's Collection</h2>
            </div>
            <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                {womenProducts.map(product => (
                    <ProductCard client:load product={product} />
                ))}
            </div>
        </section>

        <section id="kids" className="mb-16 scroll-mt-24">
            <div className="flex items-center justify-between mb-8 border-b border-gray-800 pb-4">
                <h2 className="text-3xl font-bold text-white">Kids Collection</h2>
            </div>
            <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                {kidsProducts.map(product => (
                    <ProductCard client:load product={product} />
                ))}
            </div>
        </section>
    </div>

    <CartModal client:load />
</Layout>
