---
import Layout from '../layouts/Layout.astro';
import { ProductCard } from '../components/ProductCard';
import { products } from '../data/products';
---

<Layout title="Fashion Store">
    <div class="mb-10 text-center">
        <h1 class="mb-4">Welcome to our Fashion Store</h1>
        <p class="text-lg text-gray-300">Discover our latest collection of trendy and classic pieces.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
        {products.map(product => (
            <ProductCard client:load product={product} />
        ))}
    </div>
</Layout>