---
import Layout from '../layouts/Layout.astro';
import { ProductCard } from '../components/react/ProductCard';
import { products } from '../data/products';
---

<Layout title="Welcome to Fashion Store">
    <div class="mb-12 text-center">
        <h1 class="mb-4">New Arrivals</h1>
        <p class="text-xl text-gray-400 max-w-2xl mx-auto">Discover our latest collection of premium fashion essentials designed for everyday comfort and style.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 mb-20">
        {products.map((product) => (
            <ProductCard product={product} client:load />
        ))}
    </div>
</Layout>
