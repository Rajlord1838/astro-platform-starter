---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import CartModal from '../components/react/CartModal';
import { products } from '../data/products';
---

<Layout title="Fashion Store">
    <div class="mb-12">
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl mb-4">Latest Collection</h1>
        <p class="text-xl text-gray-300">Discover our newest arrivals for the season.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {products.map((product) => (
            <ProductCard product={product} />
        ))}
    </div>

    <CartModal client:load />
</Layout>
