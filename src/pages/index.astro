---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/products';
---

<Layout title="Fashion Store">
    <div class="mb-12 text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Latest Collection</h1>
        <p class="text-gray-400 max-w-2xl mx-auto">
            Discover our newest arrivals. High-quality fashion essentials designed for everyday style and comfort.
        </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 pb-16">
        {products.map((product) => (
            <ProductCard product={product} />
        ))}
    </div>
</Layout>
