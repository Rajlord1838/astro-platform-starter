---
import Layout from '../layouts/Layout.astro';
import { products } from '../data/products';
import { AddToCartButton } from '../components/AddToCartButton';

---

<Layout title="Welcome to Fashion Store">
    <h1 class="mb-10 text-4xl font-bold">Latest Arrivals</h1>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {products.map((product) => (
            <div class="bg-gray-800 rounded-lg overflow-hidden shadow-lg flex flex-col">
                <img
                    src={product.image}
                    alt={product.name}
                    class="w-full h-64 object-cover"
                    loading="lazy"
                />
                <div class="p-6 flex flex-col flex-grow">
                    <div class="flex justify-between items-start mb-4">
                        <h2 class="text-xl font-semibold text-white">{product.name}</h2>
                        <span class="text-lg font-bold text-green-400">${product.price.toFixed(2)}</span>
                    </div>
                    <p class="text-gray-300 mb-6 flex-grow">{product.description}</p>
                    <div class="mt-auto">
                        <AddToCartButton productId={product.id} client:load />
                    </div>
                </div>
            </div>
        ))}
    </div>
</Layout>
