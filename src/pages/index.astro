---
import Layout from '../layouts/Layout.astro';
import { products } from '../utils/products';
import { AddToCartButton } from '../components/Cart';
---

<Layout title="Lumina Fashion">
    <div class="mb-16 text-center">
        <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl md:text-6xl text-black mb-4">
            New Arrivals
        </h1>
        <p class="max-w-2xl mx-auto text-xl text-gray-500">
            Discover our latest collection of premium fashion for the modern wardrobe.
        </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {products.map((product) => (
            <div class="group relative flex flex-col bg-white rounded-lg border border-gray-200 shadow-sm overflow-hidden hover:shadow-md transition-shadow">
                <div class="aspect-h-4 aspect-w-3 bg-gray-200 sm:aspect-none sm:h-96">
                    <img
                        src={product.image}
                        alt={product.name}
                        class="w-full h-full object-cover object-center sm:w-full sm:h-full group-hover:opacity-75 transition-opacity"
                    />
                </div>
                <div class="flex-1 p-4 space-y-2 flex flex-col justify-between">
                    <div>
                        <h3 class="text-sm font-medium text-gray-900">
                            {product.name}
                        </h3>
                        <p class="text-sm text-gray-500">{product.category}</p>
                    </div>
                    <div>
                        <p class="text-base font-medium text-gray-900">${product.price.toFixed(2)}</p>
                        <AddToCartButton product={product} client:load />
                    </div>
                </div>
            </div>
        ))}
    </div>
</Layout>
