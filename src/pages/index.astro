---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.tsx';
import { products } from '../data/products.ts';
---

<Layout title="Welcome to the Fashion Store">
    <div class="mb-12 text-center">
        <h1 class="mb-4 text-4xl font-extrabold sm:text-5xl lg:text-6xl text-white">Latest Collection</h1>
        <p class="text-xl text-gray-400 max-w-2xl mx-auto">Discover our new arrivals featuring premium quality materials and modern designs.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
        {products.map(product => (
            <ProductCard client:load product={product} />
        ))}
    </div>
</Layout>