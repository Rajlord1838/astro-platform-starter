---
import Layout from '../layouts/Layout.astro';
import { ProductCard } from '../components/ProductCard';
import { products } from '../data/products';
---

<Layout title="Fashion Store - Welcome">
    <div class="mb-10 text-center">
        <h1 class="mb-4">Welcome to Our Fashion Store</h1>
        <p class="text-xl text-gray-300">Discover our latest collection of premium clothing and accessories.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {products.map((product) => (
            <ProductCard client:load product={product} />
        ))}
    </div>
</Layout>
