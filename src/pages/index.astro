---
import Layout from '../layouts/Layout.astro';
import { ProductCard } from '../components/ProductCard';
import { Cart } from '../components/Cart';
import { products } from '../data/products';

const heroImage = "https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&q=80&w=2000";
---

<Layout title="Lumina Style | Modern Fashion">
    <div class="mb-16 rounded-2xl overflow-hidden relative min-h-[400px] flex items-center">
        <div class="absolute inset-0 z-0">
            <img
                src={heroImage}
                alt="New collection showcase"
                class="w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-r from-gray-900/90 to-gray-900/40"></div>
        </div>

        <div class="relative z-10 px-8 py-12 sm:px-16 sm:py-20 max-w-2xl">
            <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-6xl text-white">
                Spring Collection <span class="text-primary">2024</span>
            </h1>
            <p class="mb-8 text-lg text-gray-200">
                Discover our latest arrivals featuring modern silhouettes, sustainable materials, and timeless designs for your everyday wardrobe.
            </p>
            <a href="#shop" class="btn btn-lg inline-block">
                Shop the Collection
            </a>
        </div>
    </div>

    <div id="shop" class="scroll-mt-8">
        <div class="flex items-end justify-between mb-8">
            <div>
                <h2 class="text-3xl font-bold text-white mb-2">Featured Products</h2>
                <p class="text-gray-400">Handpicked essentials for this season.</p>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {products.map(product => (
                <ProductCard product={product} client:load />
            ))}
        </div>
    </div>

    <dialog
        id="cart-modal"
        class="backdrop:bg-black/60 bg-transparent m-0 fixed top-0 right-0 h-full max-h-none w-full sm:w-auto p-0 translate-x-full open:translate-x-0 transition-transform duration-300 ease-in-out z-50 open:flex justify-end"
    >
        <Cart client:load />
    </dialog>

    <style>
        dialog {
            /* Basic styling for when not fully supported, handled by tailwind classes */
        }

        dialog[open] {
            animation: slideIn 0.3s ease-out forwards;
        }

        dialog::backdrop {
            background: rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(4px);
            animation: fadeIn 0.3s ease-out forwards;
        }

        @keyframes slideIn {
            from {
                transform: translateX(100%);
            }
            to {
                transform: translateX(0);
            }
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
            }
            to {
                opacity: 1;
            }
        }
    </style>
</Layout>
