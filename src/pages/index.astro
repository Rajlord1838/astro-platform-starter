---
import Layout from '../layouts/Layout.astro';
import { ProductCard } from '../components/react/ProductCard.tsx';
import { products } from '../data/products.ts';
---

<Layout title="Fashion Store">
    <div class="text-center mb-12 mt-6">
        <h1 class="text-4xl sm:text-5xl font-extrabold text-gray-900 tracking-tight mb-4">Latest Arrivals</h1>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">Discover our newest collection of premium clothing and accessories. Designed for comfort and style.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {products.map(product => (
            <ProductCard client:load product={product} />
        ))}
    </div>
</Layout>
