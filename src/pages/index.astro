---
import Layout from '../layouts/Layout.astro';
import { ProductCard } from '../components/react/ProductCard';
import { CartDrawer } from '../components/react/CartDrawer';
import { products } from '../data/products';
---

<Layout title="Fashion Store">
    <div class="mb-10 text-center">
        <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl md:text-6xl">
            Latest Arrivals
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-xl text-gray-200">
            Discover our new collection of premium fashion essentials, crafted for style and comfort.
        </p>
    </div>

    <div class="grid grid-cols-1 gap-y-10 gap-x-6 sm:grid-cols-2 lg:grid-cols-3 xl:gap-x-8 pb-20">
        {products.map((product) => (
            <ProductCard client:load product={product} />
        ))}
    </div>

    <CartDrawer client:load />
</Layout>
