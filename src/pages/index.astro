---
import Layout from '../layouts/Layout.astro';
import ProductList from '../components/ProductList';
---

<Layout title="Fashion Store | Latest Trends & Styles">
    <div class="mb-12 text-center bg-gray-900 rounded-2xl py-16 px-6 border border-gray-800">
        <h1 class="text-4xl sm:text-5xl font-extrabold mb-4 text-white">Elevate Your Style</h1>
        <p class="text-xl text-gray-400 max-w-2xl mx-auto">Discover premium fashion that speaks to your unique personality. From everyday essentials to statement pieces.</p>
    </div>

    <ProductList client:load />
</Layout>
