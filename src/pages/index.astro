---
import Layout from '../layouts/Layout.astro';
import { ProductCard } from '../components/react/ProductCard';
import { products } from '../data/products';
---

<Layout title="Fashion Store | Latest Trends">
    <div class="mb-12 text-center">
        <h1 class="mb-4">Summer Collection</h1>
        <p class="text-xl text-gray-400 max-w-2xl mx-auto">
            Discover our latest arrivals. Elevate your everyday style with our premium, sustainable essentials.
        </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
        {products.map((product) => (
            <ProductCard client:load product={product} />
        ))}
    </div>
</Layout>
