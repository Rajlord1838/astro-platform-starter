---
import Layout from '../layouts/Layout.astro';
import { ProductCard } from '../components/react/ProductCard';
import { CartModal } from '../components/react/CartModal';
import { products } from '../data/products';
---

<Layout title="Fashion Store">
    <div class="mb-12">
        <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl mb-4">
            New Arrivals
        </h1>
        <p class="text-xl text-gray-500 max-w-3xl">
            Check out our latest collection of premium clothing and accessories for the new season.
        </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 mb-24">
        {products.map(product => (
            <ProductCard product={product} client:load />
        ))}
    </div>

    <CartModal client:load />
</Layout>
