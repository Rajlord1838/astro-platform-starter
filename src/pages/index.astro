---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/react/ProductCard.tsx';
import CartModal from '../components/react/CartModal.tsx';
import { products } from '../data/products';
---

<Layout title="Fashion Store - Latest Trends">
    <div class="mb-12">
        <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl mb-4">Latest Arrivals</h1>
        <p class="text-lg text-gray-500">Discover our newest collection of premium fashion essentials.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {products.map((product) => (
            <ProductCard client:load product={product} />
        ))}
    </div>

    <CartModal client:load />
</Layout>
