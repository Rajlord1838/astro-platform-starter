---
import Layout from '../layouts/Layout.astro';
import { products } from '../data/products';
import AddToCartButton from '../components/react/AddToCartButton';
import CartModalContent from '../components/react/CartModalContent';
---

<Layout title="FashionStore - Latest Trends">
    <div class="mb-12">
        <h1 class="mb-4 text-4xl font-bold tracking-tight sm:text-5xl">Latest Trends</h1>
        <p class="text-lg text-gray-600">Discover our new arrivals and find your perfect style.</p>
    </div>

    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((product) => (
            <div class="flex flex-col overflow-hidden bg-white rounded-lg shadow-sm border border-gray-100 transition-shadow hover:shadow-md">
                <img
                    src={product.image}
                    alt={product.name}
                    class="object-cover w-full h-64"
                    loading="lazy"
                />
                <div class="flex flex-col flex-1 p-6">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-xs font-medium tracking-wider text-gray-500 uppercase">
                            {product.category}
                        </span>
                        <span class="text-lg font-bold text-gray-900">
                            ${product.price.toFixed(2)}
                        </span>
                    </div>
                    <h2 class="mb-2 text-xl font-bold text-gray-900">{product.name}</h2>
                    <p class="mb-6 text-sm text-gray-600 line-clamp-2 flex-1">
                        {product.description}
                    </p>
                    <div class="mt-auto">
                        <AddToCartButton product={product} client:load />
                    </div>
                </div>
            </div>
        ))}
    </div>

    <dialog id="cart-modal" class="p-0 bg-transparent backdrop:bg-gray-900/50 rounded-lg shadow-2xl m-auto w-full max-w-md open:animate-in open:fade-in open:zoom-in-95">
        <CartModalContent client:load />
    </dialog>
</Layout>

<style>
    dialog::backdrop {
        background: rgba(0, 0, 0, 0.5);
    }
</style>
