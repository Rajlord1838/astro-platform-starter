---
import Layout from '../layouts/Layout.astro';
import AddToCart from '../components/AddToCart';
import { products } from '../data/products';
---

<Layout title="Fashion Store">
    <div class="mb-12">
        <h1 class="mb-4 text-4xl font-extrabold md:text-5xl lg:text-6xl text-white">Latest Collection</h1>
        <p class="text-lg font-normal text-gray-300 lg:text-xl">Discover our new arrivals and timeless classics.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {products.map((product) => (
            <div class="bg-white rounded-lg shadow-md overflow-hidden flex flex-col h-full">
                <img
                    src={product.image}
                    alt={product.name}
                    class="w-full h-64 object-cover"
                />
                <div class="p-6 flex flex-col flex-grow text-gray-900">
                    <div class="flex justify-between items-start mb-2">
                        <h2 class="text-xl font-bold">{product.name}</h2>
                        <span class="text-lg font-bold text-primary">${product.price}</span>
                    </div>
                    <p class="text-gray-600 mb-4 flex-grow">{product.description}</p>
                    <AddToCart product={product} client:load />
                </div>
            </div>
        ))}
    </div>
</Layout>
