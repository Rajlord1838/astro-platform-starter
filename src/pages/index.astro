---
import Layout from '../layouts/Layout.astro';
import AddToCartButton from '../components/AddToCartButton';
import { products } from '../data/products';

const title = "Fashion Store - Latest Trends";
---

<Layout title={title}>
    <div class="mb-12 text-center">
        <h1 class="mb-4 text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl">
            Summer Collection 2024
        </h1>
        <p class="max-w-2xl mx-auto text-lg text-gray-500">
            Discover our latest arrivals featuring lightweight fabrics and vibrant colors perfect for the season.
        </p>
    </div>

    <div class="grid grid-cols-1 gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3 xl:gap-x-8">
        {products.map((product) => (
            <div class="group relative flex flex-col overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm hover:shadow-md transition-shadow">
                <div class="aspect-h-4 aspect-w-3 bg-gray-200 sm:aspect-none sm:h-96">
                    <img
                        src={product.image}
                        alt={product.name}
                        class="h-full w-full object-cover object-center sm:h-full sm:w-full"
                    />
                </div>
                <div class="flex flex-1 flex-col p-4">
                    <div class="flex justify-between items-start mb-2">
                        <div>
                            <p class="text-sm text-gray-500">{product.category}</p>
                            <h3 class="text-lg font-medium text-gray-900 mt-1">
                                <a href="#">
                                    <span aria-hidden="true" class="absolute inset-0"></span>
                                    {product.name}
                                </a>
                            </h3>
                        </div>
                        <p class="text-lg font-semibold text-gray-900">${product.price.toFixed(2)}</p>
                    </div>
                    <p class="text-sm text-gray-500 mb-6 line-clamp-2">
                        {product.description}
                    </p>

                    <div class="mt-auto relative z-10">
                        <AddToCartButton product={product} client:load />
                    </div>
                </div>
            </div>
        ))}
    </div>
</Layout>
