---
import Layout from '../layouts/Layout.astro';
import { products } from '../data/products';
import AddToCartButton from '../components/react/AddToCartButton';
---

<Layout title="Fashion Store | Shop the latest trends">
    <div class="mb-12 text-center">
        <h1 class="mb-4 text-4xl font-extrabold tracking-tight sm:text-5xl lg:text-6xl text-white">
            Discover Your Style
        </h1>
        <p class="max-w-2xl mx-auto text-xl text-gray-300">
            Shop the latest trends in fashion. Quality clothing for every occasion.
        </p>
    </div>

    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((product) => (
            <div class="flex flex-col overflow-hidden transition-all duration-300 bg-gray-900 rounded-xl hover:shadow-2xl hover:shadow-primary/20 hover:-translate-y-1">
                <div class="relative aspect-[3/4] overflow-hidden">
                    <img
                        src={product.imageUrl}
                        alt={product.title}
                        class="object-cover w-full h-full transition-transform duration-500 hover:scale-105"
                    />
                    <div class="absolute top-4 left-4">
                        <span class="px-3 py-1 text-xs font-semibold tracking-wider uppercase bg-white/90 text-gray-900 rounded-full backdrop-blur-sm">
                            {product.category}
                        </span>
                    </div>
                </div>

                <div class="flex flex-col flex-1 p-6">
                    <div class="flex items-start justify-between mb-2">
                        <h2 class="text-xl font-bold text-white line-clamp-1" title={product.title}>
                            {product.title}
                        </h2>
                        <span class="text-lg font-bold text-primary whitespace-nowrap ml-4">
                            ${product.price.toFixed(2)}
                        </span>
                    </div>

                    <p class="flex-1 text-sm text-gray-400 line-clamp-2 mb-6" title={product.description}>
                        {product.description}
                    </p>

                    <div class="mt-auto">
                        <AddToCartButton client:load product={product} />
                    </div>
                </div>
            </div>
        ))}
    </div>
</Layout>
