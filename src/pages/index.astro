---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/react/ProductCard.tsx';
import { products } from '../data/products';

---

<Layout title="Welcome to Fashion Store.">
    <div class="mb-10 text-center">
        <h1 class="mb-4 text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl">Latest Arrivals</h1>
        <p class="text-lg text-gray-500">Discover our new collection of premium clothing.</p>
    </div>

    <div class="grid grid-cols-1 gap-y-10 gap-x-6 sm:grid-cols-2 lg:grid-cols-3 xl:gap-x-8">
        {products.map((product) => (
            <ProductCard product={product} client:load />
        ))}
    </div>
</Layout>
