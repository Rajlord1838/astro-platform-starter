---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/react/ProductCard';
import { products } from '../data/products';
---

<Layout title="Fashion Store - Latest Trends">
    <div class="mb-12">
        <h1 class="mb-4 text-4xl font-extrabold md:text-5xl lg:text-6xl text-white">
            Summer Collection <span class="text-primary">2024</span>
        </h1>
        <p class="text-lg font-normal text-gray-300 lg:text-xl">
            Discover the latest trends in fashion and explore our new arrivals.
        </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8 pb-20">
        {products.map((product) => (
            <ProductCard client:load product={product} />
        ))}
    </div>
</Layout>
