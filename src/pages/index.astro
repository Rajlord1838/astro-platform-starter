---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/react/ProductCard';
import CartModal from '../components/react/CartModal';
import { products } from '../data/products';
---

<Layout title="Fashion Store">
    <div className="mb-12">
        <h1 className="mb-4">Welcome to Fashion Store</h1>
        <p className="text-xl text-gray-300">Discover our latest collection of premium clothing and accessories.</p>
    </div>

    <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
        {products.map((product) => (
            <ProductCard client:load product={product} />
        ))}
    </div>

    <CartModal client:load />
</Layout>
