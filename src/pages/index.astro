---
import Layout from '../layouts/Layout.astro';
import { ProductCard } from '../components/react/ProductCard';
import { products } from '../data/products';
---

<Layout title="Fashion Store">
    <div class="mb-12 text-center">
        <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl mb-4">
            New Arrivals
        </h1>
        <p class="mt-4 max-w-xl mx-auto text-xl text-gray-300">
            Check out our latest collection of premium fashion items. Quality materials and modern designs for everyday wear.
        </p>
    </div>

    <div class="grid grid-cols-1 gap-y-10 gap-x-6 sm:grid-cols-2 lg:grid-cols-3 xl:gap-x-8 pb-24">
        {products.map((product) => (
            <ProductCard product={product} client:load />
        ))}
    </div>
</Layout>
