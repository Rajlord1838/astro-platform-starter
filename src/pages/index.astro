---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard';
import { products } from '../data/products';
---

<Layout title="StyleStore - Latest Fashion Trends">
    <div class="mb-12 text-center">
        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-4">
            Discover Your Style
        </h1>
        <p class="text-lg text-gray-400 max-w-2xl mx-auto">
            Explore our curated collection of the latest fashion trends. From casual everyday wear to elegant statement pieces.
        </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 pb-16">
        {products.map((product) => (
            <ProductCard product={product} client:load />
        ))}
    </div>
</Layout>
