---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/react/ProductCard';
import { products } from '../data/products';
---

<Layout title="Fashion Store - Trendy Apparel">
    <div class="py-8">
        <div class="mb-12 text-center">
            <h1 class="mb-4">Trendy Fashion</h1>
            <p class="text-xl text-gray-300 max-w-2xl mx-auto">
                Discover the latest trends in fashion. Quality apparel for every occasion.
            </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
            {products.map(product => (
                <ProductCard client:load product={product} />
            ))}
        </div>
    </div>
</Layout>
