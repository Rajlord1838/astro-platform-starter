---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/products';
---

<Layout title="Welcome to Fashion Store.">
    <div class="mb-16">
        <div class="relative overflow-hidden rounded-2xl bg-gray-900">
            <div class="absolute inset-0">
                <img
                    src="https://images.unsplash.com/photo-1441984904996-e0b6ba687e04?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80"
                    alt="Fashion background"
                    class="h-full w-full object-cover opacity-40"
                />
            </div>
            <div class="relative px-6 py-24 sm:px-12 sm:py-32 lg:px-16">
                <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl mb-6">
                    Summer Collection 2024
                </h1>
                <p class="max-w-xl text-lg text-gray-300 mb-8">
                    Discover the latest trends in fashion. Sustainably sourced, ethically made, and designed for your comfort.
                </p>
                <a href="#products" class="btn btn-lg inline-block">
                    Shop Now
                </a>
            </div>
        </div>
    </div>

    <div id="products" class="mb-24">
        <h2 class="text-3xl font-bold tracking-tight text-white mb-8">Featured Products</h2>
        <div class="grid grid-cols-1 gap-y-10 gap-x-6 sm:grid-cols-2 lg:grid-cols-3 xl:gap-x-8">
            {products.map((product) => (
                <ProductCard product={product} />
            ))}
        </div>
    </div>
</Layout>
