---
import Layout from '../layouts/Layout.astro';
import { ProductCard } from '../components/react/ProductCard';
import { products } from '../data/products';
---

<Layout title="Fashion Store">
    <div class="mb-10">
        <h1 class="text-4xl font-bold mb-4">Latest Arrivals</h1>
        <p class="text-slate-400 text-lg">Explore our new collection of premium fashion essentials.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {products.map((product) => (
            <ProductCard client:load product={product} />
        ))}
    </div>
</Layout>
