---
import Layout from '../layouts/Layout.astro';
import { StoreHeader } from '../components/react/StoreHeader';
import { ProductCard } from '../components/react/ProductCard';
import { products } from '../data/products';
---

<Layout title="FashionStore | New Arrivals">
    <StoreHeader client:load />

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="text-center mb-12">
            <h1 class="text-4xl font-extrabold text-gray-900 sm:text-5xl sm:tracking-tight lg:text-6xl">
                New Arrivals
            </h1>
            <p class="max-w-xl mx-auto mt-4 text-xl text-gray-500">
                Check out the latest additions to our collection. Discover trends that fit your style.
            </p>
        </div>

        <div class="grid grid-cols-1 gap-y-10 sm:grid-cols-2 gap-x-6 lg:grid-cols-3 xl:gap-x-8">
            {products.map((product) => (
                <ProductCard product={product} client:load />
            ))}
        </div>
    </main>
</Layout>
