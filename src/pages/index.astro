---
import Layout from '../layouts/Layout.astro';
import { ProductCard } from '../components/ProductCard.tsx';
import { products } from '../data/products.ts';
---

<Layout title="Welcome to our Fashion Store.">
    <div class="mb-12">
        <h1 class="mb-4 text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl">Latest Arrivals</h1>
        <p class="text-lg text-gray-600">Discover our new collection of stylish and comfortable clothing.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {products.map(product => (
            <ProductCard client:load product={product} />
        ))}
    </div>
</Layout>
