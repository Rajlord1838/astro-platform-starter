---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/react/ProductCard';
import CartDrawer from '../components/react/CartDrawer';
import { products } from '../data/products';
---

<Layout title="Fashion Store | Premium Clothing & Accessories">
  <div class="mb-12 text-center">
    <h1 class="text-4xl md:text-6xl font-extrabold mb-4 tracking-tight">Elevate Your Style</h1>
    <p class="text-xl text-gray-300 max-w-2xl mx-auto">Discover our curated collection of premium clothing, shoes, and accessories designed for the modern lifestyle.</p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
    {products.map((product) => (
      <ProductCard client:load product={product} />
    ))}
  </div>

  <CartDrawer client:load />
</Layout>
