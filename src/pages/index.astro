---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/react/ProductCard.tsx';
import { products } from '../data/products';
---

<Layout title="Fashion Store - Discover the Latest Trends">
    <section className="mb-12">
        <h1 class="text-center mb-4">Discover Your Style</h1>
        <p class="text-center text-gray-600 max-w-2xl mx-auto mb-10 text-lg">
            Explore our curated collection of contemporary fashion. From timeless classics to modern trends, find the perfect pieces to express your unique identity.
        </p>
    </section>

    <section>
        <div class="flex items-center justify-between mb-8">
            <h2 class="text-2xl font-bold text-gray-900">Featured Products</h2>
            <div class="flex gap-2">
                <span class="text-sm text-gray-500">{products.length} items</span>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
            {products.map((product) => (
                <ProductCard product={product} client:load />
            ))}
        </div>
    </section>
</Layout>
