---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/react/ProductCard';
import { products } from '../data/products';
---

<Layout title="Fashion Store - Latest Trends">
    <div class="mb-12">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-4">
            New Arrivals
        </h1>
        <p class="text-lg text-gray-600 max-w-2xl">
            Discover our latest collection of premium essentials. Curated for comfort, designed for style.
        </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-x-6 gap-y-10">
        {products.map((product) => (
            <ProductCard product={product} client:load />
        ))}
    </div>
</Layout>
