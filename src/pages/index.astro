---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { CartModal } from '../components/react/CartModal';
import { products } from '../data/products';
---

<Layout title="Lumina Fashion">
    <div class="mb-12 text-center md:text-left py-12 md:py-20">
        <h1 class="text-4xl md:text-6xl font-extrabold text-gray-900 tracking-tight mb-4">
            Discover Your Style
        </h1>
        <p class="text-xl text-gray-600 max-w-2xl">
            Explore our curated collection of timeless classics and modern essentials. Designed for comfort, styled for life.
        </p>
    </div>

    <div class="mb-8">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">New Arrivals</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
            {products.map((product) => (
                <ProductCard product={product} />
            ))}
        </div>
    </div>

    <CartModal client:load />
</Layout>
