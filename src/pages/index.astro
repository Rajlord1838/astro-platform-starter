---
import Layout from '../layouts/Layout.astro';
import { products } from '../data/products';
import ProductCard from '../components/react/ProductCard';
import Cart from '../components/react/Cart';
---

<Layout title="Fashion Store | Modern Apparel">
    <div class="mb-12">
        <h1 class="mb-4">Latest Collection</h1>
        <p class="text-lg text-gray-600 max-w-2xl">Discover our carefully curated selection of modern apparel. Designed for comfort, styled for everyday wear.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 mb-20">
        {products.map(product => (
            <ProductCard client:load product={product} />
        ))}
    </div>

    <Cart client:load />
</Layout>
