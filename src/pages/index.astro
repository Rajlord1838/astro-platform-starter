---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/react/ProductCard.tsx';
import { products } from '../data/products';

---

<Layout title="Fashion Store">
    <div class="mb-12">
        <h1 class="mb-4 text-3xl font-bold sm:text-5xl">Latest Collection</h1>
        <p class="text-slate-400 text-lg">Discover our premium fashion items for every occasion.</p>
    </div>

    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((product) => (
            <ProductCard product={product} client:load />
        ))}
    </div>
</Layout>
