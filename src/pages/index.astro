---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard';
import { products } from '../data/products';
---

<Layout title="Luxe Fashion | Modern Clothing Store">
    {/* Hero Section */}
    <section class="relative h-[70vh] min-h-[500px] flex items-center justify-center overflow-hidden">
        <div class="absolute inset-0 z-0">
            <img
                src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&q=80&w=2000"
                alt="Fashion Model"
                class="w-full h-full object-cover opacity-40"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-complementary via-complementary/50 to-transparent"></div>
        </div>

        <div class="relative z-10 text-center px-6 max-w-4xl mx-auto">
            <h1 class="text-5xl md:text-7xl font-black mb-6 tracking-tight">
                Redefine Your <span class="text-primary">Style</span>
            </h1>
            <p class="text-lg md:text-xl text-gray-300 mb-10 max-w-2xl mx-auto font-light">
                Discover our latest collection of premium clothing designed for the modern individual. Quality materials meets contemporary design.
            </p>
            <a href="#collection" class="btn btn-lg px-8 rounded-full shadow-lg shadow-primary/20">
                Shop the Collection
            </a>
        </div>
    </section>

    {/* Featured Collection Section */}
    <section id="collection" class="py-20 px-6 sm:px-12 max-w-7xl mx-auto w-full">
        <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold mb-4">Latest Arrivals</h2>
            <div class="h-1 w-20 bg-primary mx-auto rounded-full"></div>
            <p class="mt-4 text-gray-400 max-w-2xl mx-auto">
                Hand-picked pieces perfect for the current season. Upgrade your wardrobe with our versatile essentials.
            </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
            {products.map((product) => (
                <ProductCard product={product} client:load />
            ))}
        </div>
    </section>

    {/* Newsletter Section */}
    <section class="py-24 px-6 relative overflow-hidden bg-gray-900 mt-10">
        <div class="absolute inset-0 opacity-10 bg-[url('https://images.unsplash.com/photo-1558769132-cb1aea458c5e?auto=format&fit=crop&q=80&w=2000')] bg-cover bg-center mix-blend-overlay"></div>
        <div class="max-w-3xl mx-auto text-center relative z-10">
            <h2 class="text-3xl font-bold mb-4">Join the Club</h2>
            <p class="text-gray-400 mb-8">Subscribe to our newsletter to receive updates on new arrivals, special offers, and style inspiration.</p>
            <form class="flex flex-col sm:flex-row gap-3 max-w-lg mx-auto" onsubmit="event.preventDefault(); alert('Subscribed!');">
                <input
                    type="email"
                    placeholder="Enter your email address"
                    class="flex-1 bg-gray-800 border border-gray-700 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors"
                    required
                />
                <button type="submit" class="btn sm:w-auto w-full cursor-pointer">
                    Subscribe
                </button>
            </form>
        </div>
    </section>
</Layout>
