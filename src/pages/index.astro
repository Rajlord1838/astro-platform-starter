---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard';
import { products } from '../utils/products';
---

<Layout title="Fashion Store">
    <div class="mb-10">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Trending Now</h1>
        <p class="text-xl text-gray-300">Discover our latest collection of premium fashion essentials.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 pb-20">
        {products.map(product => (
            <ProductCard product={product} client:load />
        ))}
    </div>
</Layout>
