---
import Layout from '../layouts/Layout.astro';
import { ProductCard } from '../components/react/ProductCard';
import { products } from '../data/products';
---

<Layout title="Fashion Store">
    <div class="mb-12">
        <h1 class="text-4xl font-bold mb-4">Latest Collection</h1>
        <p class="text-gray-300">Discover our newest arrivals and timeless classics.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 pb-24">
        {products.map((product) => (
            <ProductCard client:load product={product} />
        ))}
    </div>
</Layout>
