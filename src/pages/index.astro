---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/react/ProductCard';
import { products } from '../data/products';
---

<Layout title="AstroFashion | Modern Clothing Store">
    <div class="mb-12 text-center max-w-2xl mx-auto">
        <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 tracking-tight mb-4">
            New Arrivals
        </h1>
        <p class="text-lg text-gray-600">
            Discover our latest collection of premium clothing and accessories, designed for comfort and style.
        </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
        {products.map(product => (
            <ProductCard client:load product={product} />
        ))}
    </div>
</Layout>
