---
import Layout from '../layouts/Layout.astro';
import { ProductCard } from '../components/ProductCard';
import { products } from '../data/products';
---

<Layout title="Welcome to Fashion Store">
    <div class="py-12">
        <h1 class="mb-8 text-center text-4xl font-bold tracking-tight sm:text-5xl">Our Latest Collection</h1>
        <p class="mb-12 text-center text-lg text-gray-300">Discover the perfect blend of style and comfort.</p>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:gap-8">
            {products.map((product) => (
                <ProductCard product={product} client:load />
            ))}
        </div>
    </div>
</Layout>
