---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard';
import { products } from '../utils/products';
---

<Layout title="FashionStore | Home">
    <div class="mb-12 text-center sm:text-left">
        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-4">Latest Collection</h1>
        <p class="text-lg text-gray-300">Discover your new favorite styles for the season.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 pb-20">
        {products.map(product => (
            <ProductCard product={product} client:load />
        ))}
    </div>
</Layout>
