---
import Layout from '../layouts/Layout.astro';
import AddToCartButton from '../components/AddToCartButton';
import { products } from '../data/products';
---

<Layout title="CHICSTYLE | Fashion Store">
    <div class="mb-12 text-center">
        <h1 class="mb-4 text-4xl font-bold md:text-5xl lg:text-6xl text-primary">New Arrivals</h1>
        <p class="text-xl text-gray-400">Discover our latest collection of premium fashion.</p>
    </div>

    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((product) => (
            <div class="flex flex-col overflow-hidden transition-transform duration-300 bg-gray-900 border border-gray-800 rounded-lg hover:shadow-xl hover:-translate-y-1">
                <div class="relative w-full h-64 overflow-hidden bg-gray-800">
                    <img
                        src={product.imageUrl}
                        alt={product.name}
                        class="object-cover w-full h-full transition-transform duration-700 hover:scale-105"
                        loading="lazy"
                    />
                    <div class="absolute top-4 left-4 bg-black/60 backdrop-blur-md px-3 py-1 text-xs font-semibold tracking-wider text-white uppercase rounded-full">
                        {product.category}
                    </div>
                </div>
                <div class="flex flex-col flex-grow p-6">
                    <div class="flex items-start justify-between mb-2">
                        <h2 class="text-xl font-bold leading-tight text-white">{product.name}</h2>
                        <span class="text-lg font-bold text-primary">${product.price.toFixed(2)}</span>
                    </div>
                    <p class="flex-grow mb-6 text-sm text-gray-400 line-clamp-2">{product.description}</p>
                    <div class="mt-auto">
                        <AddToCartButton product={product} client:load />
                    </div>
                </div>
            </div>
        ))}
    </div>
</Layout>
