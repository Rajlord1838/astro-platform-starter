---
import Layout from '../layouts/Layout.astro';
import ProductList from '../components/react/ProductList';
import CartModal from '../components/react/CartModal';
---

<Layout title="Fashion Store">
    <div class="mb-8">
        <h1 class="mb-4 text-center">Welcome to Fashion Store</h1>
        <p class="text-center text-gray-300 text-lg">Find the best fashion items here.</p>
    </div>

    <ProductList client:load />
    <CartModal client:load />
</Layout>
