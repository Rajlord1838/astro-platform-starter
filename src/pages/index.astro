---
import Layout from '../layouts/Layout.astro';
import { ProductCard } from '../components/shop/ProductCard';
import { products } from '../data/products';
---

<Layout title="Fashion Store - Shop Latest Trends">
    <div class="mb-12 text-center">
        <h1 class="mb-4 text-4xl sm:text-5xl font-extrabold tracking-tight">New Arrivals</h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto">Discover our latest collection of premium fashion items designed for comfort and style.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {products.map((product) => (
            <ProductCard product={product} client:load />
        ))}
    </div>
</Layout>
