---
import Layout from '../layouts/Layout.astro';
import { ProductCard } from '../components/ProductCard.tsx';
import { products } from '../data/products';
---

<Layout title="FashionStore | Quality Clothing & Accessories">
    <div class="mb-12 text-center sm:text-left">
        <h1 class="mb-4">New Arrivals Collection</h1>
        <p class="text-lg text-gray-300 max-w-2xl">
            Discover our latest collection of premium clothing and accessories.
            Designed for comfort, built for style.
        </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 pb-16">
        {products.map(product => (
            <ProductCard product={product} client:load />
        ))}
    </div>
</Layout>
