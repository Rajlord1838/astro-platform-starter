---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard';
import { products } from '../data/products';
---

<Layout title="Fashion Store">
    <div class="mb-12 rounded-2xl bg-gray-100 p-8 sm:p-12 text-center">
        <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl md:text-6xl">
            Summer Collection
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-xl text-gray-500">
            Discover our new arrivals. Effortless style for everyday wear.
        </p>
    </div>

    <div>
        <h2 class="text-2xl font-bold tracking-tight text-gray-900 mb-6">Latest Arrivals</h2>
        <div class="grid grid-cols-1 gap-y-10 gap-x-6 sm:grid-cols-2 lg:grid-cols-3 xl:gap-x-8">
            {products.map((product) => (
                <ProductCard client:load product={product} />
            ))}
        </div>
    </div>
</Layout>
