---
import Layout from '../layouts/Layout.astro';
import { ProductCard } from '../components/ProductCard';
import { products } from '../data/products';

---

<Layout title="Welcome to the Fashion Store.">
    <div class="mb-12">
        <h1 class="mb-4">Fashion Store</h1>
        <p class="text-lg text-gray-300">Discover our latest collection of premium fashion essentials.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {products.map((product) => (
            <ProductCard client:load product={product} />
        ))}
    </div>
</Layout>
