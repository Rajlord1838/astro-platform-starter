---
import Layout from '../layouts/Layout.astro';
import { ProductCard } from '../components/react/ProductCard.tsx';
import { CartModalWrapper } from '../components/react/CartModalWrapper.tsx';
import { products } from '../data/products';
---

<Layout title="Fashion Store">
    <div class="mb-12">
        <h1 class="mb-4">Welcome to Fashion Store</h1>
        <p class="text-xl text-gray-400">Discover our latest collection of trendy and comfortable clothing.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {products.map((product) => (
            <ProductCard client:load product={product} />
        ))}
    </div>

    <CartModalWrapper client:load />
</Layout>
