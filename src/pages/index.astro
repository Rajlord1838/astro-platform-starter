---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.tsx';
import { products } from '../data/products';
---

<Layout title="FashionStore - Trendy Clothing & Accessories">
    <div class="py-12">
        <div class="text-center mb-16">
            <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-4">Summer Collection is Here</h1>
            <p class="text-lg text-gray-300 max-w-2xl mx-auto">
                Discover our latest arrivals featuring breathable fabrics, vibrant colors, and timeless designs perfect for the warm season.
            </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
            {products.map(product => (
                <ProductCard product={product} client:load />
            ))}
        </div>
    </div>
</Layout>
