---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard';
import { products } from '../data/products';

const featuredProducts = products.slice(0, 4);
---

<Layout title="Fashion Store - Home">
    <div class="mb-12 text-center pt-8">
        <h1 class="text-4xl md:text-5xl font-bold mb-4 tracking-tight">Summer Collection</h1>
        <p class="text-xl text-gray-400 max-w-2xl mx-auto">Discover our latest arrivals. Sustainable, comfortable, and stylish fashion for everyone.</p>
    </div>

    <section class="mb-16">
        <div class="flex justify-between items-end mb-8">
            <h2 class="text-2xl font-bold">Featured Products</h2>
            <a href="/products" class="text-sm font-semibold hover:text-gray-300 transition-colors underline underline-offset-4">View All</a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {featuredProducts.map(product => (
                <ProductCard product={product} client:load />
            ))}
        </div>
    </section>

    <section class="mb-16 rounded-xl overflow-hidden relative min-h-[400px] flex items-center p-8 md:p-16 bg-gray-900 border border-gray-800">
        <div class="relative z-10 max-w-lg">
            <h2 class="text-3xl md:text-4xl font-bold mb-4">Quality Materials</h2>
            <p class="text-lg text-gray-300 mb-8">We use only the finest organic cotton and sustainable materials to ensure comfort that lasts.</p>
            <a href="/about" class="inline-block py-3 px-6 bg-white text-black font-semibold rounded hover:bg-gray-200 transition-colors">Learn More</a>
        </div>
        <div class="absolute inset-0 z-0 opacity-40">
            <img
                src="https://images.unsplash.com/photo-1489987707023-af843ce4e117?auto=format&fit=crop&q=80&w=2000"
                alt="Fabric texture"
                class="w-full h-full object-cover"
            />
        </div>
    </section>
</Layout>
