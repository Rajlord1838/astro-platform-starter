---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard';
import { products } from '../data/products';
---

<Layout title="Fashion Store - Latest Trends">
    <div class="mb-12 text-center">
        <h2 class="mb-4 text-4xl font-extrabold tracking-tight sm:text-5xl">Latest Trends</h2>
        <p class="text-xl text-gray-400">Discover our collection of premium clothing and accessories.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
        {products.map((product) => (
            <ProductCard client:load product={product} />
        ))}
    </div>
</Layout>
