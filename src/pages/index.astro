---
import Layout from '../layouts/Layout.astro';
import ContextAlert from '../components/ContextAlert.astro';
import { products } from '../data/products';
import AddToCartButton from '../components/react/AddToCartButton.tsx';
---

<Layout title="Fashion Store">
    <ContextAlert class="mb-8" />
    <h1 class="mb-10">Fashion Store</h1>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {products.map((product) => (
            <div class="bg-white rounded-lg shadow-md overflow-hidden text-gray-800 flex flex-col">
                <img src={product.imageUrl} alt={product.name} class="w-full h-64 object-cover" />
                <div class="p-4 flex flex-col flex-1">
                    <div class="flex justify-between items-start mb-2">
                        <h2 class="text-xl font-bold">{product.name}</h2>
                        <span class="text-lg font-semibold text-primary">${product.price.toFixed(2)}</span>
                    </div>
                    <p class="text-sm text-gray-500 mb-4 flex-1">{product.description}</p>
                    <div class="mt-auto">
                        <AddToCartButton product={product} client:load />
                    </div>
                </div>
            </div>
        ))}
    </div>
</Layout>
