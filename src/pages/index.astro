---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/products';
---

<Layout title="FashionStore - Latest Trends">
    <div class="mb-12">
        <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl mb-4">New Arrivals</h1>
        <p class="text-lg text-gray-500">Check out our latest collection of premium fashion items.</p>
    </div>

    <div class="grid grid-cols-1 gap-y-10 gap-x-6 sm:grid-cols-2 lg:grid-cols-3 xl:gap-x-8">
        {products.map((product) => (
            <ProductCard product={product} />
        ))}
    </div>
</Layout>
