---
import Layout from '../layouts/Layout.astro';
import { ProductCard } from '../components/react/ProductCard';
import { CartModal } from '../components/react/CartModal';
import { products } from '../data/products';
---

<Layout title="Fashion Store">
    <div class="mb-12">
        <h1 class="mb-4 text-4xl font-bold tracking-tight sm:text-5xl">Latest Collection</h1>
        <p class="text-lg text-gray-300 max-w-2xl">
            Discover our curated selection of premium fashion essentials, designed for comfort and style.
        </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-20">
        {products.map((product) => (
            <ProductCard product={product} client:load />
        ))}
    </div>

    <CartModal client:load />
</Layout>
