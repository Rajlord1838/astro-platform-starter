---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/react/ProductCard';
import { products } from '../data/products';
---

<Layout title="FashionStore | New Collection">
    <div class="py-12">
        <div class="mb-12 text-center">
            <h1 class="mb-4">New Arrivals</h1>
            <p class="text-gray-400 text-lg max-w-2xl mx-auto">
                Discover our latest collection of premium fashion items designed for comfort and style.
            </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
            {products.map(product => (
                <ProductCard product={product} client:load />
            ))}
        </div>
    </div>
</Layout>
