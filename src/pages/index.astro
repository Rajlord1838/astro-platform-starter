---
import Layout from '../layouts/Layout.astro';
import { ProductList } from '../components/ProductList';
---

<Layout title="Fashion Store">
    <div class="mb-10 text-center">
        <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl lg:text-6xl text-white mb-4">
            Welcome to Fashion Store
        </h1>
        <p class="mt-4 max-w-xl mx-auto text-xl text-gray-300">
            Discover our latest collection of premium clothing and accessories.
        </p>
    </div>

    <ProductList client:load />
</Layout>
