---
import Layout from '../layouts/Layout.astro';
import AddToCartButton from '../components/react/AddToCartButton';
import { products } from '../data/products';
---

<Layout title="FashionStore | Discover Your Style">
    <div class="mb-12 text-center">
        <h1 class="mb-4">Discover Your Style</h1>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
            Explore our curated collection of premium fashion pieces designed for everyday elegance and comfort.
        </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {products.map((product) => (
            <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow border border-gray-100 group">
                <div class="relative overflow-hidden aspect-[4/5]">
                    <img
                        src={product.image}
                        alt={product.name}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                        loading="lazy"
                    />
                    <div class="absolute top-4 right-4 bg-white/90 backdrop-blur-sm px-3 py-1 rounded-full text-sm font-semibold text-gray-900 shadow-sm">
                        {product.category}
                    </div>
                </div>
                <div class="p-6">
                    <div class="flex justify-between items-start mb-2">
                        <h2 class="text-xl font-bold text-gray-900 mb-0">{product.name}</h2>
                        <span class="text-lg font-bold text-primary ml-2">${product.price}</span>
                    </div>
                    <p class="text-gray-600 mb-4 h-12 overflow-hidden text-sm line-clamp-2">{product.description}</p>

                    <AddToCartButton product={product} client:load />
                </div>
            </div>
        ))}
    </div>
</Layout>
