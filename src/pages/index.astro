---
import Layout from '../layouts/Layout.astro';
import { ProductCard } from '../components/react/ProductCard';
import { products } from '../data/products';
---

<Layout title="Fashion Store">
    <div class="py-10">
        <div class="text-center mb-12">
            <h1 class="text-4xl font-extrabold tracking-tight text-white mb-4">Latest Arrivals</h1>
            <p class="text-lg text-gray-300">Discover our new collection of premium fashion.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
            {products.map((product) => (
                <ProductCard product={product} client:load />
            ))}
        </div>
    </div>
</Layout>
