---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/react/ProductCard';
import CartModal from '../components/react/CartModal';
import { products } from '../data/products';
---

<Layout title="FashionStore | Home">
    <div class="py-10">
        <div class="text-center mb-12">
            <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl lg:text-6xl text-white mb-4">
                Latest Collection
            </h1>
            <p class="max-w-2xl mx-auto text-xl text-gray-200">
                Discover our new arrivals and find your perfect style for any occasion.
            </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
            {products.map((product) => (
                <ProductCard client:load product={product} />
            ))}
        </div>
    </div>

    <CartModal client:load />
</Layout>
