---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard';
import { products } from '../data/products';
---

<Layout title="Fashion Store - Latest Trends">
    <div class="mb-12">
        <h1 class="mb-4">Welcome to Our Fashion Store</h1>
        <p class="text-xl text-gray-300">Discover the latest trends and everyday essentials.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 pb-12">
        {products.map(product => (
            <ProductCard product={product} client:load />
        ))}
    </div>
</Layout>
