---
import Layout from '../layouts/Layout.astro';
import { products } from '../data/products';
import { AddToCartButton } from '../components/AddToCartButton';
---

<Layout title="Fashion Store - Latest Trends">
    <section class="mb-16 rounded-xl overflow-hidden relative min-h-[400px] flex items-center bg-gray-900">
        <img
            src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80"
            alt="Fashion model"
            class="absolute inset-0 w-full h-full object-cover opacity-50"
        />
        <div class="relative z-10 px-8 py-16 sm:px-16 text-white max-w-2xl">
            <h1 class="mb-6 text-4xl sm:text-6xl font-extrabold tracking-tight">Summer Collection 2024</h1>
            <p class="text-xl mb-8 text-gray-200">Discover the latest trends in fashion. Sustainably sourced, ethically made, and designed for you.</p>
            <a href="#shop" class="btn btn-lg bg-white text-gray-900 hover:bg-gray-200 border-none shadow-lg">Shop Now</a>
        </div>
    </section>

    <div id="shop" class="mb-8 flex justify-between items-end border-b border-gray-700 pb-4">
        <h2 class="text-3xl font-bold">Featured Products</h2>
        <span class="text-gray-400">{products.length} items</span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
        {products.map((product) => (
            <div class="bg-white rounded-lg shadow-md overflow-hidden flex flex-col transition-transform hover:-translate-y-1">
                <div class="relative pt-[125%] overflow-hidden bg-gray-100">
                    <img
                        src={product.image}
                        alt={product.name}
                        class="absolute top-0 left-0 w-full h-full object-cover"
                        loading="lazy"
                    />
                    <div class="absolute top-2 left-2 bg-black text-white text-xs font-bold px-2 py-1 uppercase tracking-wider rounded">
                        {product.category}
                    </div>
                </div>
                <div class="p-6 flex flex-col flex-grow">
                    <h3 class="text-xl font-bold mb-2 text-black">{product.name}</h3>
                    <p class="text-gray-600 mb-4 line-clamp-2 text-sm flex-grow">{product.description}</p>
                    <div class="flex items-center justify-between mt-auto">
                        <span class="text-2xl font-bold text-primary">${product.price.toFixed(2)}</span>
                    </div>
                    <AddToCartButton product={product} client:load />
                </div>
            </div>
        ))}
    </div>
</Layout>
