---
import Layout from '../layouts/Layout.astro';
import { products } from '../data/products';
import { AddToCartButton } from '../components/react/AddToCartButton';
---

<Layout title="Fashion Store">
    <div class="mb-12">
        <h1 class="mb-4 text-4xl font-bold tracking-tight sm:text-5xl">Latest Collection</h1>
        <p class="text-lg text-gray-400">Discover our new arrivals and find your perfect style.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {products.map((product) => (
            <div class="flex flex-col bg-gray-900 rounded-lg overflow-hidden border border-gray-800 shadow-lg transition-transform hover:-translate-y-1">
                <div class="aspect-h-1 aspect-w-1 w-full overflow-hidden bg-gray-200 xl:aspect-h-8 xl:aspect-w-7">
                    <img
                        src={product.image}
                        alt={product.name}
                        class="h-64 w-full object-cover object-center"
                    />
                </div>
                <div class="flex flex-col flex-1 p-6">
                    <h3 class="text-xl font-medium text-white mb-2">{product.name}</h3>
                    <p class="text-gray-400 text-sm flex-1 mb-4">{product.description}</p>
                    <p class="text-2xl font-bold text-white mb-6">${product.price.toFixed(2)}</p>
                    <AddToCartButton product={product} client:load />
                </div>
            </div>
        ))}
    </div>
</Layout>
