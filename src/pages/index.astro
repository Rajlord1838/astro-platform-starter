---
import Layout from '../layouts/Layout.astro';
import { products } from '../data/products';
import { ProductCard } from '../components/react/ProductCard';
import { CartModal } from '../components/react/CartModal';
---

<Layout title="Fashion Store">
    <div class="mb-10 text-center">
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl mb-4">Latest Collection</h1>
        <p class="text-lg text-gray-300 max-w-2xl mx-auto">Discover our new arrivals featuring premium materials and contemporary designs perfect for your everyday style.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
        {products.map((product) => (
            <ProductCard product={product} client:load />
        ))}
    </div>

    <CartModal client:load />
</Layout>
