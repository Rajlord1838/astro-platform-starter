---
import Layout from '../layouts/Layout.astro';
import { ProductCard } from '../components/react/ProductCard';
import { products } from '../data/products';
---

<Layout title="Fashion Store">
    <div class="mb-10 text-center">
        <h1 class="mb-4 text-4xl font-bold tracking-tight sm:text-5xl">Latest Arrivals</h1>
        <p class="text-lg text-gray-300">Discover our new collection of premium fashion essentials.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 pb-16">
        {products.map(product => (
            <ProductCard product={product} client:load />
        ))}
    </div>
</Layout>
