---
import Layout from '../layouts/Layout.astro';
import ProductList from '../components/react/ProductList';
import { products } from '../data/products';
---

<Layout title="VogueStore - Modern Fashion">
  <div class="mb-8">
    <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl mb-4">Latest Arrivals</h1>
    <p class="text-lg text-gray-600">Discover our curated collection of timeless fashion pieces.</p>
  </div>

  <ProductList products={products} client:load />
</Layout>
