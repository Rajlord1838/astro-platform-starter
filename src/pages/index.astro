---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import CartModal from '../components/react/CartModal';
import { products } from '../data/products';
---

<Layout title="FashionStore | Modern Apparel">
    <div class="py-8">
        <div class="text-center mb-12">
            <h1 class="text-4xl font-bold tracking-tight mb-4">Summer Collection is Here</h1>
            <p class="text-gray-400 max-w-2xl mx-auto">
                Discover our latest arrivals featuring breathable fabrics, vibrant colors, and timeless silhouettes perfect for the warm days ahead.
            </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
            {products.map(product => (
                <ProductCard product={product} />
            ))}
        </div>
    </div>

    <CartModal client:load />
</Layout>
