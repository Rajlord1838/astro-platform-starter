---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/react/ProductCard.tsx';
import { products } from '../data/products';
---

<Layout title="Fashion Store - Latest Trends">
    <div class="mb-12 text-center">
        <h1 class="mb-4 text-4xl font-bold tracking-tight sm:text-5xl">New Arrivals</h1>
        <p class="text-lg text-gray-300 max-w-2xl mx-auto">
            Discover the latest trends in fashion. From casual wear to elegant styles, find the perfect outfit for any occasion.
        </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 mb-16">
        {products.map(product => (
            <ProductCard product={product} client:load />
        ))}
    </div>
</Layout>
