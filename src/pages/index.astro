---
import Layout from '../layouts/Layout.astro';
import { ProductCard } from '../components/react/ProductCard';
import { CartModal } from '../components/react/CartModal';
import { products } from '../data/products';
---

<Layout title="Chic Boutique - Fashion Store">
    <div className="py-8">
        <h1 class="text-3xl font-bold mb-8 text-center text-gray-900">New Arrivals</h1>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            {products.map((product) => (
                <ProductCard client:load product={product} />
            ))}
        </div>
    </div>

    <CartModal client:load />
</Layout>
