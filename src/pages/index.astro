---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Welcome to our Fashion Store">
    <div class="flex flex-col items-center justify-center py-20 text-center">
        <h1 class="mb-6 text-5xl font-bold tracking-tight sm:text-6xl text-white">
            Discover Your Style
        </h1>
        <p class="mb-10 text-xl text-gray-300 max-w-2xl">
            Explore our curated collection of trendy and comfortable fashion pieces for every occasion. Update your wardrobe today with our latest arrivals.
        </p>
        <p>
            <a href="/shop" class="btn btn-lg sm:min-w-64 px-8 py-4 bg-white text-black font-semibold rounded-lg hover:bg-gray-200 transition-colors">
                Shop Now
            </a>
        </p>
    </div>

    <div class="mt-20 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-gray-800 rounded-lg p-6 flex flex-col items-center">
            <h3 class="text-2xl font-semibold mb-4">Men's Collection</h3>
            <p class="text-gray-400 mb-6 text-center">Fresh looks and classic staples for the modern man.</p>
            <a href="/shop?category=men" class="text-blue-400 hover:text-blue-300">View Men's &rarr;</a>
        </div>
        <div class="bg-gray-800 rounded-lg p-6 flex flex-col items-center">
            <h3 class="text-2xl font-semibold mb-4">Women's Collection</h3>
            <p class="text-gray-400 mb-6 text-center">Elegant designs and comfortable fits for every woman.</p>
            <a href="/shop?category=women" class="text-blue-400 hover:text-blue-300">View Women's &rarr;</a>
        </div>
        <div class="bg-gray-800 rounded-lg p-6 flex flex-col items-center md:col-span-2 lg:col-span-1">
            <h3 class="text-2xl font-semibold mb-4">Accessories</h3>
            <p class="text-gray-400 mb-6 text-center">Complete your look with our premium accessories.</p>
            <a href="/shop?category=accessories" class="text-blue-400 hover:text-blue-300">View Accessories &rarr;</a>
        </div>
    </div>
</Layout>
