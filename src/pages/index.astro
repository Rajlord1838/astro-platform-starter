---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/products';
---

<Layout title="Lumière | Sustainable Fashion Essentials">
    <div class="mb-12 text-center md:mb-16">
        <h1 class="mb-4 text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl md:text-6xl">
            Elevate Your Everyday
        </h1>
        <p class="mx-auto max-w-2xl text-lg text-gray-600">
            Discover our latest collection of sustainable, high-quality fashion essentials designed for modern living.
        </p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:gap-8">
        {products.map((product) => (
            <ProductCard product={product} />
        ))}
    </div>
</Layout>
