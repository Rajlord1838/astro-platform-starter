---
import Layout from '../layouts/Layout.astro';
import ProductList from '../components/ProductList.astro';
---

<Layout title="Fashion Store - Latest Trends">
    <div class="mb-16 text-center">
        <h1 class="mb-6">Discover Your Style</h1>
        <p class="max-w-2xl mx-auto mb-8 text-lg text-gray-600">
            Explore our curated collection of premium fashion pieces. From timeless classics to modern trends, find everything you need to elevate your wardrobe.
        </p>
        <a href="#products" class="btn btn-lg">Shop Now</a>
    </div>

    <section id="products" class="pt-8 mt-12 border-t border-gray-200">
        <h2 class="mb-8">Featured Products</h2>
        <ProductList />
    </section>
</Layout>
