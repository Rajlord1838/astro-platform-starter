---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/react/ProductCard';
import { products } from '../data/products';
---

<Layout title="Fashion Store - Latest Collection">
    <div class="mb-12">
        <h1 class="mb-4 text-3xl font-bold tracking-tight sm:text-4xl text-center">
            New Arrivals
        </h1>
        <p class="text-center text-gray-300 max-w-2xl mx-auto text-lg">
            Discover our latest collection of premium fashion essentials, designed for comfort and everyday style.
        </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
        {products.map((product) => (
            <ProductCard product={product} client:load />
        ))}
    </div>
</Layout>
