---
import Layout from '../layouts/Layout.astro';
import { ProductCard } from '../components/ProductCard';
import { products } from '../data/products';
---

<Layout title="Welcome to StyleStore.">
    <div class="relative bg-gray-900 rounded-2xl overflow-hidden mb-16">
        <div class="absolute inset-0">
            <img src="https://images.unsplash.com/photo-1441984904996-e0b6ba687e04?auto=format&fit=crop&q=80&w=2070" alt="Fashion store background" class="w-full h-full object-cover opacity-40" />
        </div>
        <div class="relative max-w-7xl mx-auto py-24 px-4 sm:py-32 sm:px-6 lg:px-8 flex flex-col items-center text-center">
            <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl">New Season Arrivals</h1>
            <p class="mt-6 text-xl text-gray-300 max-w-3xl">Discover our latest collection of premium clothing and accessories. Designed for comfort, styled for you.</p>
            <div class="mt-10">
                <a href="#products" class="inline-block bg-white border border-transparent rounded-md py-3 px-8 text-base font-medium text-gray-900 hover:bg-gray-100 transition-colors">Shop Now</a>
            </div>
        </div>
    </div>

    <div id="products" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between mb-8">
            <h2 class="text-2xl font-bold tracking-tight text-gray-900">Featured Products</h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-y-10 gap-x-6 xl:gap-x-8">
            {products.map((product) => (
                <ProductCard product={product} client:load />
            ))}
        </div>
    </div>
</Layout>
