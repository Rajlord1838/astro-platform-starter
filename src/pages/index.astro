---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/react/ProductCard';
import { products } from '../data/products';
---

<Layout title="LUMIÈRE - Fashion Store">
    <div class="py-12 sm:py-24">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="text-center">
                <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-6xl text-white">
                    New Collection
                </h1>
                <p class="mt-4 text-lg text-gray-300">
                    Discover our latest arrivals for the season.
                </p>
            </div>

            <div class="mt-16 grid grid-cols-1 gap-y-10 gap-x-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 xl:gap-x-8">
                {products.map((product) => (
                    <ProductCard product={product} client:load />
                ))}
            </div>
        </div>
    </div>
</Layout>
