---
import Layout from '../layouts/Layout.astro';
import { products } from '../data/products';
import AddToCartButton from '../components/AddToCartButton';
---

<Layout title="Fashion Store - Latest Trends">
    <div class="space-y-16">
        {/* Hero Section */}
        <section class="relative bg-gray-900 rounded-2xl overflow-hidden">
            <div class="absolute inset-0">
                <img
                    class="w-full h-full object-cover opacity-60"
                    src="https://images.unsplash.com/photo-1441984904996-e0b6ba687e04?auto=format&fit=crop&w=1600&q=80"
                    alt="Fashion background"
                />
            </div>
            <div class="relative max-w-7xl mx-auto py-24 px-4 sm:py-32 sm:px-6 lg:px-8">
                <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl text-shadow-sm">
                    New Arrivals
                </h1>
                <p class="mt-6 text-xl text-gray-100 max-w-3xl text-shadow-sm">
                    Discover the latest trends in fashion. Shop our exclusive collection of clothing, accessories, and footwear.
                </p>
                <div class="mt-10">
                    <a href="#collection" class="inline-block bg-white border border-transparent py-3 px-8 rounded-md font-medium text-gray-900 hover:bg-gray-100 transition-colors">
                        Shop Collection
                    </a>
                </div>
            </div>
        </section>

        {/* Product Grid */}
        <section id="collection" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-2xl font-extrabold tracking-tight text-gray-900 mb-8">Featured Products</h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-y-10 gap-x-6 xl:gap-x-8">
                {products.map((product) => (
                    <div class="group relative flex flex-col bg-white rounded-lg shadow-sm hover:shadow-md transition-shadow overflow-hidden">
                        <div class="w-full min-h-80 bg-gray-200 aspect-w-1 aspect-h-1 rounded-t-md overflow-hidden group-hover:opacity-75 lg:h-80 lg:aspect-none">
                            <img
                                src={product.image}
                                alt={product.name}
                                class="w-full h-full object-center object-cover lg:w-full lg:h-full"
                            />
                        </div>
                        <div class="flex flex-col flex-1 p-4 justify-between space-y-4">
                            <div>
                                <h3 class="text-sm text-gray-700">
                                    <span aria-hidden="true" class="absolute inset-0 z-0"></span>
                                    {product.name}
                                </h3>
                                <p class="mt-1 text-sm text-gray-500">{product.category}</p>
                                <p class="mt-2 text-sm font-medium text-gray-900">${product.price.toFixed(2)}</p>
                            </div>
                            <div class="relative z-10">
                                <AddToCartButton product={product} client:load />
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </section>
    </div>
</Layout>
