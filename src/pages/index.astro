---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.tsx';
import Cart from '../components/Cart.tsx';
import { products } from '../data/products.ts';
---

<Layout title="Fashion Store">
    <div class="mb-12 text-center sm:mb-20">
        <h1 class="mb-4">New Arrivals</h1>
        <p class="text-lg text-white/70 max-w-2xl mx-auto">
            Discover the latest trends in our new collection. Shop the best fashion items for your everyday style.
        </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 mb-16">
        {products.map(product => (
            <ProductCard client:load product={product} />
        ))}
    </div>

    <Cart client:load />
</Layout>
