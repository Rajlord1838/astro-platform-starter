---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/products';

// Show a few featured products on the homepage
const featuredProducts = products.slice(0, 3);
---

<Layout title="Fashion Store - Discover Your Style">
    <div class="mb-16 text-center">
        <h1 class="mb-6 text-5xl font-extrabold tracking-tight sm:text-6xl text-white">
            Elevate Your <span class="text-primary">Style</span>
        </h1>
        <p class="max-w-2xl mx-auto mb-10 text-xl text-gray-400">
            Discover our curated collection of premium clothing and accessories designed for the modern trendsetter.
        </p>
        <a href="/products" class="btn btn-lg bg-white text-gray-900 hover:bg-gray-200">
            Shop the Collection
        </a>
    </div>

    <div>
        <div class="flex justify-between items-center mb-8">
            <h2 class="text-3xl font-bold">Featured Arrivals</h2>
            <a href="/products" class="text-primary hover:underline">View All &rarr;</a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {featuredProducts.map((product) => (
                <ProductCard product={product} />
            ))}
        </div>
    </div>
</Layout>
