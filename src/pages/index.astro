---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/products';
---

<Layout title="VogueStore | Latest Fashion">
    <div class="mb-16 text-center max-w-3xl mx-auto pt-8">
        <h1 class="mb-6 text-white">Elevate Your Style</h1>
        <p class="text-xl text-gray-400">Discover our latest collection of premium clothing and accessories designed for the modern lifestyle.</p>
    </div>

    <div class="flex justify-between items-center mb-8">
        <h2 class="text-2xl font-bold text-white m-0">New Arrivals</h2>
        <div class="flex gap-2">
            <span class="text-gray-400 text-sm">Sort by:</span>
            <select class="bg-transparent border-none text-white text-sm focus:outline-none cursor-pointer">
                <option value="newest" class="text-black">Newest</option>
                <option value="price-low" class="text-black">Price: Low to High</option>
                <option value="price-high" class="text-black">Price: High to Low</option>
            </select>
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {products.map((product) => (
            <ProductCard product={product} />
        ))}
    </div>
</Layout>
