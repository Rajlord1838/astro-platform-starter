---
import Layout from '../layouts/Layout.astro';
import { products } from '../utils/products';
import { AddToCartButton } from '../components/AddToCartButton';

const featuredProducts = products.slice(0, 3);
---

<Layout title="Home - Fashion Store">
    <section class="py-20 text-center">
        <h1 class="mb-6 text-5xl font-extrabold tracking-tight">Elevate Your Style.</h1>
        <p class="mb-10 text-xl text-gray-300 max-w-2xl mx-auto">
            Discover the latest trends and timeless classics in our curated collection of premium fashion items.
        </p>
        <a href="/shop" class="btn btn-lg sm:min-w-64 inline-flex">Shop the Collection</a>
    </section>

    <section class="py-12 mt-12 border-t border-white/10">
        <div class="flex justify-between items-end mb-8">
            <h2 class="text-3xl font-bold">Featured Items</h2>
            <a href="/shop" class="text-primary hover:underline">View all &rarr;</a>
        </div>

        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {featuredProducts.map((product) => (
                <div class="bg-gray-900 rounded-lg overflow-hidden shadow-lg transition-transform hover:-translate-y-1">
                    <div class="h-64 overflow-hidden relative">
                        <img src={product.image} alt={product.name} class="w-full h-full object-cover" loading="lazy" />
                        <span class="absolute top-2 right-2 bg-black/60 text-white px-2 py-1 text-xs rounded uppercase font-semibold tracking-wider">
                            {product.category}
                        </span>
                    </div>
                    <div class="p-6">
                        <h3 class="text-xl font-bold mb-2">{product.name}</h3>
                        <p class="text-gray-400 text-sm mb-4 line-clamp-2">{product.description}</p>
                        <div class="flex justify-between items-center mb-4">
                            <span class="text-lg font-bold text-white">${product.price.toFixed(2)}</span>
                        </div>
                        <AddToCartButton product={product} client:load />
                    </div>
                </div>
            ))}
        </div>
    </section>
</Layout>
