---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/react/ProductCard';
import CartModal from '../components/react/CartModal';
import { products } from '../data/products';
---

<Layout title="Astro Fashion - Discover Your Style">
    <div class="mb-12 text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Discover Your Style</h1>
        <p class="text-xl text-white/80 max-w-2xl mx-auto">
            Explore our curated collection of trendy and comfortable fashion pieces designed for everyday wear.
        </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
        {products.map((product) => (
            <ProductCard client:load product={product} />
        ))}
    </div>

    <CartModal client:load />
</Layout>
