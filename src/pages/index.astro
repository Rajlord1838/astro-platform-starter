---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard';
import Cart from '../components/Cart';
import { products } from '../data/products';
---

<Layout title="Fashion Store | Latest Collection">
    <div class="mb-12">
        <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl mb-4">
            New Arrivals
        </h1>
        <p class="text-xl text-gray-500 max-w-2xl">
            Discover our latest collection of premium clothing and accessories. Designed for comfort and style.
        </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {products.map(product => (
            <ProductCard product={product} client:load />
        ))}
    </div>

    <Cart client:load />
</Layout>
