---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.tsx';
import { products } from '../data/products.ts';

const featuredProducts = products.slice(0, 4);
---

<Layout title="Modern Fashion Store">
    <div class="flex flex-col gap-16 pb-16">
        <section class="py-12 md:py-20 text-center">
            <h1 class="mb-6 text-5xl font-extrabold tracking-tight text-gray-900 sm:text-6xl">
                Elevate Your Style
            </h1>
            <p class="mx-auto max-w-2xl text-lg text-gray-500 mb-10">
                Discover our latest collection of premium clothing and accessories. Designed for comfort and crafted for elegance.
            </p>
            <div class="flex justify-center gap-4">
                <a href="/products" class="btn btn-lg bg-gray-900 text-white hover:bg-gray-800">
                    Shop Now
                </a>
            </div>
        </section>

        <section>
            <div class="flex items-center justify-between mb-8">
                <h2 class="text-3xl font-bold tracking-tight text-gray-900">Featured Products</h2>
                <a href="/products" class="text-sm font-semibold text-gray-900 hover:underline">
                    View all &rarr;
                </a>
            </div>

            <div class="grid grid-cols-1 gap-y-10 gap-x-6 sm:grid-cols-2 lg:grid-cols-4 xl:gap-x-8">
                {featuredProducts.map((product) => (
                    <ProductCard product={product} client:load />
                ))}
            </div>
        </section>
    </div>
</Layout>
