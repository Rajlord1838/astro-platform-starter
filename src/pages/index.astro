---
import Layout from '../layouts/Layout.astro';
import { products } from '../data/products';
import AddToCartButton from '../components/react/AddToCartButton.tsx';
---

<Layout title="FashionStore | Home">
    <div class="mb-12 text-center">
        <h1 class="text-4xl sm:text-5xl font-extrabold mb-4">Discover Your Style</h1>
        <p class="text-xl text-gray-400 max-w-2xl mx-auto">Shop the latest trends in fashion and accessories with our curated collection.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {products.map((product) => (
            <div class="bg-gray-800 rounded-lg overflow-hidden shadow-lg transition-transform hover:scale-[1.02]">
                <a href={`/product/${product.id}`} class="block aspect-square overflow-hidden relative group">
                    <img
                        src={product.image}
                        alt={product.name}
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                        loading="lazy"
                    />
                    <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-20 transition-all duration-300"></div>
                </a>
                <div class="p-6">
                    <div class="flex justify-between items-start mb-2">
                        <div>
                            <p class="text-xs text-blue-400 font-semibold uppercase tracking-wider mb-1">{product.category}</p>
                            <h2 class="text-xl font-bold">
                                <a href={`/product/${product.id}`} class="hover:text-blue-400 transition-colors">
                                    {product.name}
                                </a>
                            </h2>
                        </div>
                        <span class="text-lg font-bold">${product.price.toFixed(2)}</span>
                    </div>
                    <p class="text-gray-400 text-sm mb-6 line-clamp-2">{product.description}</p>
                    <AddToCartButton product={product} client:load />
                </div>
            </div>
        ))}
    </div>
</Layout>
