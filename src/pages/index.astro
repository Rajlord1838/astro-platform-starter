---
import Layout from '../layouts/Layout.astro';
import { ProductCard } from '../components/react/ProductCard';
import { products } from '../data/products';
---

<Layout title="FashionStore - Latest Trends">
    <div class="mb-12 text-center sm:text-left">
        <h1 class="text-4xl font-extrabold text-gray-900 sm:text-5xl tracking-tight mb-4">New Arrivals</h1>
        <p class="text-lg text-gray-500 max-w-2xl">Discover the latest trends in fashion. Fresh styles added weekly to keep your wardrobe looking sharp.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 sm:gap-8">
        {products.map(product => (
            <ProductCard product={product} client:load />
        ))}
    </div>
</Layout>
