---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard';
import CartModal from '../components/CartModal';
import { products } from '../data/products';
---

<Layout title="Fashion Store">
    <div class="mb-12">
        <h1 class="mb-4 text-4xl font-extrabold tracking-tight sm:text-5xl lg:text-6xl text-white">
            New Arrivals
        </h1>
        <p class="max-w-2xl text-lg text-gray-300">
            Discover the latest trends in fashion. Elevate your wardrobe with our premium collection of clothing, shoes, and accessories designed for every occasion.
        </p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:gap-8 mb-16">
        {products.map((product) => (
            <ProductCard client:load product={product} />
        ))}
    </div>

    <CartModal client:load />
</Layout>
