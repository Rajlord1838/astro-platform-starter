---
import Layout from '../layouts/Layout.astro';
import { ProductCard } from '../components/ProductCard';
import { products } from '../data/products';
---

<Layout title="Astro Fashion Store">
    <div className="mb-10 text-center">
        <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-4 tracking-tight">New Arrivals</h1>
        <p class="text-lg text-gray-500 max-w-2xl mx-auto">Discover our latest collection of premium clothing and accessories designed for comfort and style.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
        {products.map((product) => (
            <ProductCard client:load product={product} />
        ))}
    </div>
</Layout>
