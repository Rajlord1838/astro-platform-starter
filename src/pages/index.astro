---
import Layout from '../layouts/Layout.astro';
import { ProductList } from '../components/react/ProductList';
import { CartModal } from '../components/react/CartModal';
import { products } from '../data/products';
---

<Layout title="Fashion Store">
    <div class="mb-12">
        <h1 class="text-4xl font-bold mb-4">Latest Collection</h1>
        <p class="text-gray-400 text-lg">Discover our premium selection of quality clothing and accessories.</p>
    </div>

    <ProductList client:load products={products} />

    <CartModal client:load />
</Layout>