---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard';
import Cart from '../components/Cart';
import { products } from '../data/products';
---

<Layout title="Vogue Fashion Store">
    <div class="flex flex-col gap-16">
        <section class="text-center py-16 sm:py-24 bg-gray-50 rounded-2xl px-6">
            <h1 class="text-5xl sm:text-6xl font-black text-gray-900 mb-6 tracking-tight">
                Elevate Your Style
            </h1>
            <p class="text-lg sm:text-xl text-gray-600 max-w-2xl mx-auto mb-10">
                Discover our new collection of premium clothing and accessories designed for the modern trendsetter.
            </p>
            <a href="#products" class="btn btn-lg bg-gray-900 text-white hover:bg-gray-800">
                Shop Collection
            </a>
        </section>

        <section id="products" class="scroll-mt-8">
            <div class="flex items-end justify-between mb-8">
                <h2 class="text-3xl font-bold text-gray-900">Featured Products</h2>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
                {products.map((product) => (
                    <ProductCard product={product} client:load />
                ))}
            </div>
        </section>
    </div>

    <dialog id="cart-modal" class="p-0 m-0 fixed top-0 right-0 h-full max-h-screen max-w-full backdrop:bg-gray-900/50 backdrop:backdrop-blur-sm shadow-2xl ml-auto border-none open:flex">
        <Cart client:load />
    </dialog>

    <style>
        dialog {
            transition: transform 0.3s ease-out;
            transform: translateX(100%);
        }
        dialog[open] {
            transform: translateX(0);
        }
    </style>
</Layout>
