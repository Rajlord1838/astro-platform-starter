---
import Layout from '../layouts/Layout.astro';
import AddToCartButton from '../components/AddToCartButton.tsx';
import Cart from '../components/Cart.tsx';
import { products } from '../data/products';
---

<Layout title="Fashion Store">
    <div class="mb-12 text-center">
        <h1 class="text-4xl font-bold mb-4">Latest Arrivals</h1>
        <p class="text-gray-400">Discover our newest collection for the season.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
        {products.map((product) => (
            <div class="bg-gray-800 rounded-lg overflow-hidden shadow-lg transition-transform hover:scale-105">
                <div class="h-64 overflow-hidden relative group">
                    <img
                        src={product.imageUrl}
                        alt={product.title}
                        class="w-full h-full object-cover"
                    />
                    <div class="absolute top-2 right-2 bg-black bg-opacity-70 text-white text-xs px-2 py-1 rounded">
                        {product.category}
                    </div>
                </div>
                <div class="p-6">
                    <div class="flex justify-between items-start mb-2">
                        <h2 class="text-xl font-bold">{product.title}</h2>
                        <span class="text-lg font-semibold">${product.price}</span>
                    </div>
                    <p class="text-gray-400 text-sm mb-4 line-clamp-2">{product.description}</p>
                    <AddToCartButton product={product} client:load />
                </div>
            </div>
        ))}
    </div>

    <dialog id="cart-modal" class="p-0 bg-transparent backdrop:bg-black/50 rounded-lg">
        <Cart client:load />
    </dialog>
</Layout>

<style>
    dialog::backdrop {
        background-color: rgba(0, 0, 0, 0.75);
    }
</style>
