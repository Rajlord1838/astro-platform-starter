---
import Layout from '../layouts/Layout.astro';
import { ProductCard } from '../components/ProductCard';
import CartModal from '../components/CartModal.astro';
import { products } from '../data/products';
---

<Layout title="Fashion Store">
    <div class="mb-12">
        <h1 class="mb-4">New Arrivals</h1>
        <p class="text-lg text-gray-300">Discover our latest collection of premium fashion essentials.</p>
    </div>

    <div class="grid grid-cols-1 gap-y-10 gap-x-6 sm:grid-cols-2 lg:grid-cols-3 xl:gap-x-8 mb-24">
        {products.map((product) => (
            <ProductCard product={product} client:load />
        ))}
    </div>

    <CartModal />
</Layout>
