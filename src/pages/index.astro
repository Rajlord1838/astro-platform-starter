---
import Layout from '../layouts/Layout.astro';
import ProductList from '../components/ProductList';
---

<Layout title="FashionStore - Your Destination for Style">
    <div class="py-12 md:py-20">
        <div class="text-center mb-16">
            <h1 class="text-4xl md:text-6xl font-extrabold text-gray-900 tracking-tight mb-4">
                Elevate Your Style
            </h1>
            <p class="text-lg md:text-xl text-gray-500 max-w-2xl mx-auto">
                Discover our latest collection of premium clothing and accessories designed for the modern individual.
            </p>
        </div>

        <div class="border-t border-gray-200 pt-12">
            <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center md:text-left">
                Featured Products
            </h2>
            <ProductList client:load />
        </div>
    </div>
</Layout>
