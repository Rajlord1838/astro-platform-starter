---
import Layout from '../layouts/Layout.astro';
import { ProductCard } from '../components/react/ProductCard';
import { products } from '../data/products';
---

<Layout title="Fashion Store - New Arrivals">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
        <div class="mb-12">
            <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl">New Arrivals</h1>
            <p class="mt-4 text-xl text-gray-500">Check out our latest collection of premium clothing.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
            {products.map(product => (
                <ProductCard product={product} client:load />
            ))}
        </div>
    </div>
</Layout>
