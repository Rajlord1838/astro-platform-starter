---
import Layout from '../layouts/Layout.astro';
import { ProductCard } from '../components/ProductCard.tsx';
import { products } from '../data/products.ts';
---

<Layout title="Fashion Store - Shop the Latest Trends">
    <div class="mb-12 text-center py-12 bg-slate-50 rounded-2xl">
        <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl mb-4">
            Welcome to Fashion Store
        </h1>
        <p class="text-lg text-slate-600 max-w-2xl mx-auto">
            Discover the latest trends in fashion. High-quality clothing and accessories for every occasion.
        </p>
    </div>

    <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 mb-6">Our Collection</h2>
        <div class="grid grid-cols-1 gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3 xl:gap-x-8">
            {products.map((product) => (
                <ProductCard client:load product={product} />
            ))}
        </div>
    </div>
</Layout>
