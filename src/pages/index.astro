---
import Layout from '../layouts/Layout.astro';
import { ProductCard } from '../components/ProductCard.tsx';
import { products } from '../data/products.ts';
---

<Layout title="Welcome to our Fashion Store">
    <div class="mb-12 text-center">
        <h1 class="text-4xl font-extrabold tracking-tight mb-4">Latest Arrivals</h1>
        <p class="text-lg text-gray-300">Discover our new collection for the season.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 pb-20">
        {products.map((product) => (
            <ProductCard product={product} client:load />
        ))}
    </div>
</Layout>
