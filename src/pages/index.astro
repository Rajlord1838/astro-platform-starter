---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.tsx';
import { products } from '../utils/products';
---

<Layout title="Astro Fashion Store">
    <div class="mb-12 text-center">
        <h1 class="mb-6 text-5xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-primary to-purple-400">
            Astro Fashion Store
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto">
            Discover the latest trends in fashion. High-quality clothing for every occasion, delivered right to your door.
        </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {products.map((product) => (
            <ProductCard product={product} client:load />
        ))}
    </div>
</Layout>
