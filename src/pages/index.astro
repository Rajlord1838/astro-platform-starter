---
import Layout from '../layouts/Layout.astro';
import ProductList from '../components/react/ProductList.tsx';
import Cart from '../components/react/Cart.tsx';
---

<Layout title="FashionStore - Find your style">
    <div class="py-12">
        <h1 class="mb-4 text-4xl font-bold tracking-tight text-white sm:text-5xl">
            Latest Arrivals
        </h1>
        <p class="mb-8 text-lg text-gray-300">
            Discover our newest collection of premium fashion items.
        </p>

        <ProductList client:load />
    </div>

    <Cart client:load />
</Layout>
