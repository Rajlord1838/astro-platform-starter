---
import Layout from '../layouts/Layout.astro';
import Header from '../components/react/Header';
import ProductList from '../components/react/ProductList';
import Cart from '../components/react/Cart';
import { products } from '../data/products';
---

<Layout title="FashionStore">
    <Header client:load />

    <main class="flex-grow">
        <div class="relative overflow-hidden bg-complementary pt-16 pb-32 space-y-24">
            <div class="relative">
                <div class="lg:mx-auto lg:grid lg:max-w-7xl lg:grid-flow-col-dense lg:grid-cols-2 lg:gap-24 lg:px-8">
                    <div class="mx-auto max-w-xl px-6 lg:mx-0 lg:max-w-none lg:py-16 lg:px-0">
                        <div>
                            <div class="mt-6">
                                <h2 class="text-3xl font-bold tracking-tight text-white">
                                    Discover Your Style
                                </h2>
                                <p class="mt-4 text-lg text-gray-300">
                                    Shop the latest trends in fashion. We offer a curated collection of high-quality clothing for every occasion.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <ProductList products={products} client:load />
        </div>
    </main>

    <footer class="bg-black/50 border-t border-white/10">
        <div class="mx-auto max-w-7xl overflow-hidden py-12 px-6 sm:py-16 lg:px-8">
            <p class="mt-8 text-center text-xs leading-5 text-gray-400">
                &copy; {new Date().getFullYear()} FashionStore. All rights reserved.
            </p>
        </div>
    </footer>

    <Cart client:load />
</Layout>
