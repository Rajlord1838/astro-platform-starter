---
import Layout from '../layouts/Layout.astro';
import { products } from '../data/products';
import { AddToCartButton } from '../components/AddToCartButton';
---

<Layout title="Fashion Store">
    <div class="mb-12">
        <h1 class="mb-4 text-4xl font-bold tracking-tight sm:text-5xl">Latest Arrivals</h1>
        <p class="text-lg text-gray-300">Discover our new collection of premium fashion essentials.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {products.map((product) => (
            <div class="bg-gray-900 rounded-lg overflow-hidden shadow-lg border border-gray-800 flex flex-col">
                <div class="aspect-w-3 aspect-h-4 relative">
                    <img
                        src={product.image}
                        alt={product.name}
                        class="w-full h-64 object-cover"
                    />
                </div>
                <div class="p-6 flex flex-col flex-grow">
                    <div class="flex justify-between items-start mb-2">
                        <h2 class="text-xl font-bold">{product.name}</h2>
                        <span class="text-primary font-semibold">${product.price.toFixed(2)}</span>
                    </div>
                    <p class="text-gray-400 text-sm flex-grow mb-4">{product.description}</p>
                    <AddToCartButton product={product} client:load />
                </div>
            </div>
        ))}
    </div>
</Layout>
