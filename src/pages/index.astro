---
import Layout from '../layouts/Layout.astro';
import { products } from '../data/products';
import { ProductCard } from '../components/react/ProductCard';
import { Cart } from '../components/react/Cart';
---

<Layout title="Welcome to the Fashion Store.">
    <div class="flex flex-col items-center mb-16 text-center">
        <h1 class="mb-4 text-4xl font-extrabold tracking-tight sm:text-5xl lg:text-6xl text-white">
            Discover Your Style
        </h1>
        <p class="max-w-2xl text-lg text-gray-400">
            Explore our latest collection of premium fashion items. Quality materials, modern designs, and comfortable fits for every occasion.
        </p>
    </div>

    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((product) => (
            <ProductCard product={product} client:load />
        ))}
    </div>

    <Cart client:load />
</Layout>
