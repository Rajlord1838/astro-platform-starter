---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/products';
---

<Layout title="Fashion Store - Latest Trends">
    <div class="py-12 sm:py-24">
        <div class="text-center mb-16">
            <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl mb-4">
                Discover Your <span class="text-primary">Style</span>
            </h1>
            <p class="mt-4 text-xl text-gray-400 max-w-2xl mx-auto">
                Explore our latest collection of premium clothing and accessories designed for everyday comfort and style.
            </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
            {products.map((product) => (
                <ProductCard product={product} />
            ))}
        </div>
    </div>
</Layout>
