---
import Layout from '../layouts/Layout.astro';
import ProductList from '../components/ProductList.tsx';
---

<Layout title="Fashion Store - Latest Collection">
    <div class="mb-12 text-center">
        <h1 class="mb-4">Welcome to Fashion<span class="text-primary">Store</span></h1>
        <p class="text-xl text-gray-400">Discover our latest collection of premium clothing and accessories.</p>
    </div>

    <div class="mb-16">
        <h2 class="mb-8 border-b border-gray-800 pb-2">Featured Products</h2>
        <ProductList client:load />
    </div>
</Layout>
