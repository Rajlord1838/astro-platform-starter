---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/react/ProductCard';
import { products } from '../data/products';
---

<Layout title="FashionStore | Modern Apparel">
    <div class="mb-12 text-center md:text-left">
        <h1 class="text-4xl font-bold text-gray-900 mb-4 tracking-tight">New Collection</h1>
        <p class="text-lg text-gray-600 max-w-2xl">Discover our latest arrivals featuring premium materials and modern cuts for everyday wear.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
        {products.map(product => (
            <ProductCard client:load product={product} />
        ))}
    </div>
</Layout>
