---
import Layout from '../layouts/Layout.astro';

const products = [
    { name: "Classic White T-Shirt", price: "$25.00", image: "https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" },
    { name: "Denim Jacket", price: "$89.00", image: "https://images.unsplash.com/photo-1576995853123-5a10305d93c0?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" },
    { name: "Tailored Suit", price: "$299.00", image: "https://images.unsplash.com/photo-1594938298593-78f41a15e4f9?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" },
    { name: "Casual Chinos", price: "$49.00", image: "https://images.unsplash.com/photo-1473966968600-fa801b869a1a?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" },
];
---

<Layout title="Men's Collection">
    <h1 class="mb-10 text-4xl font-bold">Men's Collection</h1>
    <section>
        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
            {products.map((product) => (
                <div class="overflow-hidden bg-gray-800 rounded-lg shadow-lg">
                    <img src={product.image} alt={product.name} class="object-cover w-full h-64" />
                    <div class="p-4">
                        <h3 class="mb-2 text-lg font-semibold">{product.name}</h3>
                        <p class="text-gray-400">{product.price}</p>
                        <button class="w-full px-4 py-2 mt-4 font-semibold text-white bg-blue-600 rounded hover:bg-blue-700 transition-colors">
                            Add to Cart
                        </button>
                    </div>
                </div>
            ))}
        </div>
    </section>
</Layout>
