---
import Layout from '../../layouts/Layout.astro';
import { products } from '../../data/products';

export function getStaticPaths() {
    return products.map(product => ({
        params: { id: product.id },
        props: { product },
    }));
}

const { product } = Astro.props;
---

<Layout title={`${product.name} - Fashion Store`}>
    <div class="py-12 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
            <a href="/shop" class="text-primary hover:underline">&larr; Back to Shop</a>
        </div>

        <div class="flex flex-col md:flex-row gap-12">
            <div class="md:w-1/2">
                <img src={product.image} alt={product.name} class="w-full rounded-lg shadow-xl object-cover h-[500px]" />
            </div>

            <div class="md:w-1/2 flex flex-col justify-center">
                <p class="text-sm text-gray-400 mb-2 uppercase tracking-wide">{product.category}</p>
                <h1 class="text-4xl font-bold mb-4">{product.name}</h1>
                <p class="text-2xl font-medium text-gray-300 mb-6">${product.price.toFixed(2)}</p>

                <div class="prose prose-invert mb-8">
                    <p class="text-lg leading-relaxed">{product.description}</p>
                </div>

                <div class="mt-auto">
                    <button class="w-full sm:w-auto px-8 py-4 bg-primary text-white font-bold rounded hover:bg-primary-dark transition-colors text-lg">
                        Add to Cart
                    </button>
                </div>
            </div>
        </div>
    </div>
</Layout>
