---
import Layout from '../../layouts/Layout.astro';
import { products, getProductById } from '../../utils/data';
import AddToCartButton from '../../components/AddToCartButton';

export function getStaticPaths() {
    return products.map(product => ({
        params: { id: product.id },
    }));
}

const { id } = Astro.params;
const product = getProductById(id as string);

if (!product) {
    return Astro.redirect('/404');
}
---

<Layout title={`${product.name} - Aura Fashion`}>
    <div class="py-8">
        <a href="/products" class="text-gray-500 hover:text-gray-900 mb-8 inline-block">&larr; Back to Products</a>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
            <div class="aspect-[3/4] overflow-hidden rounded-lg bg-gray-100">
                <img
                    src={product.image}
                    alt={product.name}
                    class="w-full h-full object-cover"
                />
            </div>
            <div class="flex flex-col justify-center">
                <h1 class="text-4xl font-bold mb-4">{product.name}</h1>
                <p class="text-2xl text-gray-700 mb-6">${product.price.toFixed(2)}</p>
                <div class="prose mb-8">
                    <p class="text-gray-600 leading-relaxed">{product.description}</p>
                </div>
                <div class="mt-auto">
                    <AddToCartButton productId={product.id} client:load />
                </div>
            </div>
        </div>
    </div>
</Layout>
