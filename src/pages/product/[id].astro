---
import Layout from '../../layouts/Layout.astro';
import { products } from '../../data/products';
import AddToCartButton from '../../components/react/AddToCartButton.tsx';

export function getStaticPaths() {
  return products.map(product => ({
    params: { id: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
---

<Layout title={`${product.name} | FashionStore`}>
    <div class="mb-6">
        <a href="/" class="inline-flex items-center text-gray-400 hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
            </svg>
            Back to Catalog
        </a>
    </div>

    <div class="bg-gray-800 rounded-2xl overflow-hidden shadow-2xl flex flex-col md:flex-row">
        <div class="md:w-1/2 aspect-square md:aspect-auto">
            <img
                src={product.image}
                alt={product.name}
                class="w-full h-full object-cover"
            />
        </div>

        <div class="md:w-1/2 p-8 md:p-12 flex flex-col justify-center">
            <p class="text-blue-400 font-semibold uppercase tracking-wider mb-2">{product.category}</p>
            <h1 class="text-3xl md:text-4xl font-bold mb-4">{product.name}</h1>
            <p class="text-2xl font-bold mb-8">${product.price.toFixed(2)}</p>

            <div class="prose prose-invert mb-10">
                <p class="text-gray-300 leading-relaxed text-lg">{product.description}</p>
            </div>

            <div class="mt-auto">
                <AddToCartButton product={product} client:load />
            </div>

            <div class="mt-8 pt-8 border-t border-gray-700 grid grid-cols-2 gap-4 text-sm text-gray-400">
                <div class="flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    In stock, ready to ship
                </div>
                <div class="flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                    </svg>
                    Free returns within 30 days
                </div>
            </div>
        </div>
    </div>
</Layout>
