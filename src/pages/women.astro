---
import Layout from '../layouts/Layout.astro';

const products = [
    { name: "Summer Floral Dress", price: "$45.00", image: "https://images.unsplash.com/photo-1572804013309-59a88b7e92f1?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" },
    { name: "Elegant Evening Gown", price: "$150.00", image: "https://images.unsplash.com/photo-1566160983863-b8296a2f8d09?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" },
    { name: "Casual Denim Skirt", price: "$35.00", image: "https://images.unsplash.com/photo-1582142407894-ec85a1260a46?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" },
    { name: "Silk Blouse", price: "$65.00", image: "https://images.unsplash.com/photo-1551163943-3f6a855d1153?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" },
];
---

<Layout title="Women's Collection">
    <h1 class="mb-10 text-4xl font-bold">Women's Collection</h1>
    <section>
        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
            {products.map((product) => (
                <div class="overflow-hidden bg-gray-800 rounded-lg shadow-lg">
                    <img src={product.image} alt={product.name} class="object-cover w-full h-64" />
                    <div class="p-4">
                        <h3 class="mb-2 text-lg font-semibold">{product.name}</h3>
                        <p class="text-gray-400">{product.price}</p>
                        <button class="w-full px-4 py-2 mt-4 font-semibold text-white bg-blue-600 rounded hover:bg-blue-700 transition-colors">
                            Add to Cart
                        </button>
                    </div>
                </div>
            ))}
        </div>
    </section>
</Layout>
